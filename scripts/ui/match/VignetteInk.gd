## The ink cell for `years` premierships (clamped to 1..MAX_YEARS) over a figure strip, or {}.
static func cell(s: Dictionary, years: int) -> Dictionary:
	if years <= 0:
		return {}
	var by: Dictionary = CELLS.get("%d,%d" % [int(s["x"]), int(s["y"])], {})
	return by.get(str(mini(years, MAX_YEARS)), {})


static func texture(c: Dictionary) -> Texture2D:
	return INK_TEXTURES[int(c["atlas"])]
