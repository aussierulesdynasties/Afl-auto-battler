## The new style's or face's cell over a figure strip (VignetteFigures.strip()), or {} for none.
static func cell(s: Dictionary, id: String) -> Dictionary:
	var by: Dictionary = CELLS.get("%d,%d" % [int(s["x"]), int(s["y"])], {})
	return by.get(id, {})


static func texture(h: Dictionary) -> Texture2D:
	return LOOK_TEXTURES[int(h["atlas"])]
