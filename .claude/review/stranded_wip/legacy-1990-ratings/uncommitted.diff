+	var informed := {}
+	for p in GameDB.players:
+		informed[str(p["id"])] = int(p["potential"])
+	Potential.informed = false
+	GameDB.reload("1990")
+	var moved := 0
+	for p in GameDB.players:
+		if int(p["potential"]) != int(informed.get(str(p["id"]), -1)):
+			moved += 1
+	Potential.informed = true
+	_check(moved > 100, "The one switch turns it off: POT is projected instead (%d moved)" % moved)
