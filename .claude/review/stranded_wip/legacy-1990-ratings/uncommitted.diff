+			continue
+		var ov := int(p["overall"])
+		var pot := int(p["potential"])
+		var peak := int(p["real_peak"])
+		var lo := ov
+		var hi := ov + int(Potential.INFORMED_NONE_ROOM)
+		if peak > 0:
