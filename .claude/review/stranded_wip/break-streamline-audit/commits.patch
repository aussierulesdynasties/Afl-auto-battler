 		rep.add_child(played)
 		rep.add_child(_quarter_view(q - 1))
 		var did := MatchNotes.calls_lines(_res, _my_side, q - 1) \
@@ -1608,7 +1612,7 @@ func _roster_side(side: int) -> Array:
 # ---------------------------------------------------------------------------
 ## The match so far in full, over the break: team and player stats for both
 ## clubs, any quarter on its own. Close (or Back) returns to your calls.
-func _show_break_stats() -> void:
+func _show_break_stats(players_first := false) -> void:
 	_close_report()
 	var box := UiKit.modal_box(self, 1100.0, 0.0, _wash())
 	var overlay: Control = box["overlay"]
@@ -1620,13 +1624,48 @@ func _show_break_stats() -> void:
 	box_score.name = "BreakBoxScore"
 	v.add_child(box_score)
 	v.add_child(UiKit.spacer(UiKit.GAP))
-	v.add_child(MatchStatsView.new().setup(_res, _my_side, true))
+	var msv := MatchStatsView.new()
+	msv.players_first = players_first
+	v.add_child(msv.setup(_res, _my_side, true))
 	var close := UiKit.btn("Back to your calls", UiKit.NAME, true)
 	close.custom_minimum_size = Vector2(0, 44)
 	close.pressed.connect(_close_report)
 	box["footer"].add_child(close)
 
 
+## Best so far, on the break: the three best of each side by match rating so
+## far (yours first), each with his rating and the numbers that stand out, as
+## full time's best players read; "All player stats" opens the full table.
+func _best_so_far() -> Control:
+	var box := UiKit.vbox(2 if _pc_break else 6)
+	box.name = "BestSoFar"
+	box.set_meta("break_unit", true)
+	var head := UiKit.hbox(8)
+	var title := UiKit.section("Best so far")
+	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	head.add_child(title)
+	var all := UiKit.text_action("All player stats", UiKit.BODY)
+	all.name = "BestSoFarAll"
+	all.pressed.connect(func(): _show_break_stats(true))
+	# On a PC the way to the table sits in the heading row, so the block is
+	# shorter and the fullest break still fits 1280x720.
+	if _pc_break:
+		all.custom_minimum_size = Vector2(0, 32)
+		head.add_child(all)
+	else:
+		all.alignment = HORIZONTAL_ALIGNMENT_LEFT
+	box.add_child(head)
+	for side in [_my_side, 1 - _my_side]:
+		# Three of yours; a PC break, tight for height, shows two of theirs.
+		for p in MatchNotes.standouts(_res, side, 2 if (_pc_break and side != _my_side) else 3):
+			var row := _standout_row(p, side, false)
+			row.name = "BestRow_%s" % str(p["id"])
+			box.add_child(row)
+	if not _pc_break:
+		box.add_child(all)
+	return box
+
+
 func _glance_section(v: VBoxContainer, title: String, node_name: String, lines: Array) -> void:
 	if lines.is_empty():
 		return
diff --git a/scripts/ui/match/MatchStatsView.gd b/scripts/ui/match/MatchStatsView.gd
index cddd25f74..936576e75 100644
--- a/scripts/ui/match/MatchStatsView.gd
+++ b/scripts/ui/match/MatchStatsView.gd
@@ -27,12 +27,16 @@ var _me := 0
 var _view := "team"
 var _scope := "all"      # "all" or the quarter number as a string
 var _live := false        # at a break: the match so far
+## Opens on the player table (the break's "All player stats"), not the team's.
+var players_first := false
 
 
 func setup(res: Dictionary, my_side: int, live := false) -> MatchStatsView:
 	_res = res
 	_me = my_side
 	_live = live
+	if players_first:
+		_view = "players"
 	add_theme_constant_override("separation", 8)
 	# The layout reads the screen's width, which a view not yet on screen
 	# can't know (it took a PC's and opened a phone in landscape columns
diff --git a/tests/floor_deltas/claude-break-best-so-far.txt b/tests/floor_deltas/claude-break-best-so-far.txt
new file mode 100644
index 000000000..eb0ce4754
--- /dev/null
+++ b/tests/floor_deltas/claude-break-best-so-far.txt
@@ -0,0 +1 @@
+matchday +9
diff --git a/tests/run_matchday_tests.gd b/tests/run_matchday_tests.gd
index eb6170cdd..dfae843c9 100644
--- a/tests/run_matchday_tests.gd
+++ b/tests/run_matchday_tests.gd
@@ -48,6 +48,7 @@ func _run() -> void:
 		await _minder_cards(sz)
 		await _loose_interceptor(sz)
 		await _main_ruck_picker(sz)
+		await _best_so_far(sz)
 	_break_units_keep_followups()
 	for club in ["COL", "GWS", "STK"]:
 		await _pc_break_worst_case(club)
@@ -799,6 +800,63 @@ func _break_units_keep_followups() -> void:
 		c.free()
 
 
+## Best so far on the break (director, 2026-10-11): three of each side by match
+## rating so far, the numbers the match's own player stats, a real tap on
+## "All player stats" opens the full table.
+func _best_so_far(sz: Vector2i) -> void:
+	var tag := "%dx%d" % [sz.x, sz.y]
+	var db = root.get_node("GameDB")
+	var notes = load("res://scripts/ui/match/MatchNotes.gd")
+	_state.reset()
+	_state.start_season("COL", db.club_list("COL"))
+	root.size = sz
+	_check(_state.prepare_interactive_match(), "A live match is prepared for Best so far (%s)" % tag)
+	var sim = _state.pending_sim
+	var me := int(sim.moment_side)
+	sim.run_quarter()
+	var res: Dictionary = sim.result()
+	var m: Control = load("res://scenes/MatchScene.tscn").instantiate()
+	root.add_child(m)
+	await _settle()
+	var box: Node = m.find_child("CoachBox", true, false)
+	var block: Node = box.find_child("BestSoFar", true, false) if box != null else null
+	_check(block != null, "The break shows Best so far (%s)" % tag)
+	if block == null:
+		m.queue_free()
+		await _settle()
+		return
+	# The top three of each side, from the match's own player stats.
+	var want := []
+	for side in [me, 1 - me]:
+		var ranked := []
+		for p in (res["roster"] as Array)[side]:
+			var st: Dictionary = (res["players"] as Dictionary).get(str(p["id"]), {})
+			ranked.append([str(p["id"]), int(notes.rating(st)), int(float(st.get("disposals", 0.0)))])
+		ranked.sort_custom(func(a, b): return a[1] > b[1] or (a[1] == b[1] and a[2] > b[2]))
+		for r in ranked.slice(0, 2 if (sz.x >= 900 and side != me) else 3):
+			want.append(r)
+	var bad := []
+	var found := 0
+	for r in want:
+		var row: Node = block.find_child("BestRow_%s" % str(r[0]), true, false)
+		if row == null:
+			bad.append("missing " + str(r[0]))
+			continue
+		found += 1
+		var rating_l: Label = row.find_child("StandoutRating", true, false)
+		if rating_l == null or rating_l.text != str(r[1]):
+			bad.append("%s rating %s v %d" % [str(r[0]), rating_l.text if rating_l else "-", int(r[1])])
+	_check(found == want.size() and bad.is_empty(), "Best so far lists the best of each side with the match's own ratings (%s: %s)" % [tag, str(bad)])
+	var all_b: Button = block.find_child("BestSoFarAll", true, false)
+	_check(all_b != null and (await Tap.tap(all_b)) == "", "All player stats takes a real tap (%s)" % tag)
+	await _settle()
+	var sheet: Node = m.find_child("BreakStatsSheet", true, false)
+	_check(sheet != null and sheet.find_child("PlayerStats", true, false) != null,
+			"...and opens the full player table (%s)" % tag)
+	m.queue_free()
+	await _settle()
+
+
 func _pc_break_worst_case(club := "COL") -> void:
 	var db = root.get_node("GameDB")
 	var Mu = load("res://scripts/sim/Matchups.gd")
@@ -829,6 +887,7 @@ func _pc_break_worst_case(club := "COL") -> void:
 	await _settle()
 	var box: Node = m.find_child("CoachBox", true, false)
 	_check(box != null and box.find_child("LooseTally", true, false) != null, "(setup) your loose man's tally is on the break")
+	_check(box != null and box.find_child("BestSoFar", true, false) != null, "Best so far is on the fullest PC break (%s)" % club)
 	var bc: Control = box.find_child("BreakColumns", true, false) if box != null else null
 	var bsc: ScrollContainer = null
 	var up: Node = bc
-- 
2.55.0.windows.5

