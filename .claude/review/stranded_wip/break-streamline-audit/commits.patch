From 546bad511b7b8e82a8a69362f6f2d43c7e12ebb7 Mon Sep 17 00:00:00 2001
From: gabebartolo-spec <gabebartolo@gmail.com>
Date: Mon, 12 Oct 2026 20:45:31 +1100
Subject: [PATCH] PC break: the call columns are dealt for the shortest tallest
 column (GWS 605 -> 593 of 608), Best so far's stat lines are tested against
 the match's own numbers

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 scripts/ui/MatchScene.gd                      | 56 +++++++++++++++++++
 .../floor_deltas/claude-break-best-so-far.txt |  2 +-
 tests/run_matchday_tests.gd                   | 34 +++++++++++
 3 files changed, 91 insertions(+), 1 deletion(-)

diff --git a/scripts/ui/MatchScene.gd b/scripts/ui/MatchScene.gd
index 30d54bbf3..a1ae376db 100644
--- a/scripts/ui/MatchScene.gd
+++ b/scripts/ui/MatchScene.gd
@@ -1064,6 +1064,12 @@ func _balance_break_columns(cols: Array) -> void:
 					break
 			if improved:
 				break
+	# The greedy answer can sit a whole call above the best there is (Best so
+	# far on the fullest PC break: 551 against 532 with the same blocks), so
+	# look for the true shortest tallest column before placing anything.
+	var exact := _shortest_tallest(h, cols.size(), load_h.max())
+	if not exact.is_empty():
+		picks = exact
 	for c in range(cols.size()):
 		(picks[c] as Array).sort()
 		for k in picks[c]:
@@ -1072,6 +1078,56 @@ func _balance_break_columns(cols: Array) -> void:
 				(cols[c] as Node).add_child(n)
 
 
+## Every way of dealing the units (heights h) into `parts` columns, searched
+## for the one whose tallest column is shortest; tallest calls first, and a
+## branch is dropped the moment it cannot beat the best so far. Returns the
+## unit numbers in each column, or an empty array when nothing beats `above`
+## (the answer the caller already has).
+static func _shortest_tallest(h: Array, parts: int, above: float) -> Array:
+	var order := range(h.size())
+	order.sort_custom(func(a, b): return float(h[a]) > float(h[b]))
+	var state := {"best": above - 0.5, "picks": [], "steps": 0}
+	var load_h: Array = []
+	var cur: Array = []
+	for c in range(parts):
+		load_h.append(0.0)
+		cur.append([])
+	_deal(order, 0, h, load_h, cur, state)
+	return state["picks"] as Array
+
+
+static func _deal(order: Array, i: int, h: Array, load_h: Array, cur: Array, state: Dictionary) -> void:
+	state["steps"] = int(state["steps"]) + 1
+	if int(state["steps"]) > 400000:
+		return
+	if i == order.size():
+		var top := 0.0
+		for l in load_h:
+			top = maxf(top, float(l))
+		if top < float(state["best"]):
+			state["best"] = top
+			var copy := []
+			for col in cur:
+				copy.append((col as Array).duplicate())
+			state["picks"] = copy
+		return
+	var k: int = order[i]
+	var seen := []
+	for c in range(load_h.size()):
+		# Two columns with the same load so far are the same choice.
+		if seen.has(float(load_h[c])):
+			continue
+		seen.append(float(load_h[c]))
+		var after := float(load_h[c]) + float(h[k])
+		if after >= float(state["best"]):
+			continue
+		load_h[c] = after
+		(cur[c] as Array).append(k)
+		_deal(order, i + 1, h, load_h, cur, state)
+		(cur[c] as Array).pop_back()
+		load_h[c] = after - float(h[k])
+
+
 ## The break's calls as units in reading order: a node marked "break_unit"
 ## starts one, and the nodes after it (its notes) go with it. A node marked
 ## "break_follow" is the follow-up to the question before it (Tag, then who
diff --git a/tests/floor_deltas/claude-break-best-so-far.txt b/tests/floor_deltas/claude-break-best-so-far.txt
index 283298115..6336617d6 100644
--- a/tests/floor_deltas/claude-break-best-so-far.txt
+++ b/tests/floor_deltas/claude-break-best-so-far.txt
@@ -1 +1 @@
-matchday +16
+matchday +24
diff --git a/tests/run_matchday_tests.gd b/tests/run_matchday_tests.gd
index b03d4daa0..21b37967d 100644
--- a/tests/run_matchday_tests.gd
+++ b/tests/run_matchday_tests.gd
@@ -51,6 +51,7 @@ func _run() -> void:
 		await _main_ruck_picker(sz)
 		await _best_so_far(sz)
 	_break_units_keep_followups()
+	_break_packing_is_shortest()
 	for club in ["COL", "GWS", "STK"]:
 		await _pc_break_worst_case(club)
 	await _tag_not_saved()
@@ -816,6 +817,29 @@ func _follows_its_question(par: Node, at: int) -> bool:
 	return false
 
 
+## The height packer deals a break's calls into four columns so the tallest is
+## as short as it can be. The units are GWS's fullest PC break with Best so far
+## (heights in px, measured): the old greedy deal left a column of 551, the
+## best deal is 532.
+func _break_packing_is_shortest() -> void:
+	var ms = load("res://scripts/ui/MatchScene.gd")
+	var h := [333.0, 96.0, 122.0, 133.0, 124.0, 263.0, 140.0, 240.0, 122.0, 207.0, 176.0, 122.0]
+	var picks: Array = ms.call("_shortest_tallest", h, 4, 1000.0)
+	var seen := []
+	var tallest := 0.0
+	for col in picks:
+		var t := 0.0
+		for k in col:
+			seen.append(int(k))
+			t += float(h[int(k)])
+		tallest = maxf(tallest, t)
+	seen.sort()
+	_check(picks.size() == 4 and seen == range(h.size()), "Every call lands in exactly one column (%s)" % str(seen))
+	_check(tallest <= 540.0, "The tallest column is the shortest there is, not the greedy 551 (%.0f)" % tallest)
+	_check((ms.call("_shortest_tallest", h, 4, tallest) as Array).is_empty(),
+			"No better deal exists than the shortest one found (%.0f)" % tallest)
+
+
 ## The packer's grouping on a made-up break (a follow-up is the first thing in
 ## the next column): it stays with its question, whichever column holds it.
 func _break_units_keep_followups() -> void:
@@ -898,6 +922,14 @@ func _best_so_far(sz: Vector2i) -> void:
 		var rating_l: Label = row.find_child("StandoutRating", true, false)
 		if rating_l == null or rating_l.text != str(r[1]):
 			bad.append("%s rating %s v %d" % [str(r[0]), rating_l.text if rating_l else "-", int(r[1])])
+		# ...and his stat line is the match's own numbers in words (game_line of
+		# result["players"], read now), not a second count.
+		var line_want: String = notes.game_line((res["players"] as Dictionary).get(str(r[0]), {}))
+		var texts := []
+		for lb in row.find_children("*", "Label", true, false):
+			texts.append((lb as Label).text)
+		if not texts.has(line_want):
+			bad.append("%s line %s not shown" % [str(r[0]), line_want])
 	_check(found == want.size() and bad.is_empty(), "Best so far lists the best of each side with the match's own ratings (%s: %s)" % [tag, str(bad)])
 	# Each side under its own club name, even numbers each; on a phone the
 	# block sits below the controls, so the next quarter's choices are never
@@ -959,6 +991,8 @@ func _pc_break_worst_case(club := "COL") -> void:
 	var need := (bsc.get_child(0) as Control).get_combined_minimum_size().y if bsc != null else INF
 	_check(box != null and box.find_child("SpareMinderPicker", true, false) != null and need <= room + 1.0,
 			"Quarter time with both loose men and your tally fits 1280x720 without scrolling (%s: %.0f of %.0f)" % [club, need, room])
+	# With room to spare: a longer name or one more line must not tip it over.
+	_check(need <= 608.0 - 8.0, "...with at least 8 px to spare (%s: %.0f of 608)" % [club, need])
 	# Packing moves whole calls: no column opens on a bare line without its
 	# heading (a sentence, a note such as the synergies line, cut loose from its block),
 	# and the synergies line sits with the legs line it is about.
