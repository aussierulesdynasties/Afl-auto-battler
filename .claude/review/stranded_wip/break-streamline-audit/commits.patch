diff --git a/scripts/ui/MatchScene.gd b/scripts/ui/MatchScene.gd
index 7622137fb..6b90c56b5 100644
--- a/scripts/ui/MatchScene.gd
+++ b/scripts/ui/MatchScene.gd
@@ -637,10 +637,14 @@ func _show_coach_box() -> void:
 		else:
 			rep.add_child(stats)
 			rep.add_child(UiKit.spacer(UiKit.GAP))
+		# Who is playing well, right on the break (director, 2026-10-11): the top
