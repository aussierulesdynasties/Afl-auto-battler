+		var raw: Color = db.club_colours(c)[int(UK.INK_SLOT.get(c, 0))] if int(UK.INK_SLOT.get(c, 0)) >= 0 else UK.TEXT
+		var sw := ColorRect.new()
+		sw.color = raw
