diff --git a/tools/visual/audit.py b/tools/visual/audit.py
new file mode 100644
index 000000000..3c6350601
--- /dev/null
+++ b/tools/visual/audit.py
@@ -0,0 +1,169 @@
+"""Counts and stitched boards for the break audit. Usage:
+  audit.py count  <prefix>            -> counts for <prefix>.json (closed/open)
+  audit.py tall   <prefix> <out.png> <title>   -> phone: closed | open stitched tall, labelled
+  audit.py pair   <out.png> <title> label1=file1 label2=file2 ...  -> images side by side (or stacked with --stack)
+"""
+import json, sys, os, re
+from PIL import Image, ImageDraw, ImageFont
+
+BG = (18, 17, 16)
+INK = (241, 238, 230)
+MUTED = (163, 158, 147)
+HOT = (255, 196, 64)
+
+
+def font(sz, bold=False):
+    for f in (["arialbd.ttf"] if bold else []) + ["arial.ttf"]:
+        try:
+            return ImageFont.truetype(f, sz)
+        except Exception:
+            pass
+    return ImageFont.load_default()
+
+
+def words(t):
+    return len(re.findall(r"[A-Za-z0-9'’\-]+", t))
+
+
+def count_state(st, view_h=None):
+    nodes = st["nodes"]
+    buttons = [n for n in nodes if n["cls"] == "Button" and not n["in_button"]]
+    labels = [n for n in nodes if n["cls"] == "Label"]
+    w = sum(words(n["text"]) for n in labels) + sum(words(n["text"]) for n in buttons)
+    expl = [n for n in labels if n["col"].lower() == "a39e93" and n["fs"] <= 13 and not n["in_button"] and words(n["text"]) >= 4]
+    expl_lines = sum(n["lines"] for n in expl)
+    out = {"buttons": len(buttons), "words": w, "explanation_labels": len(expl), "explanation_lines": expl_lines,
+           "content_h": st["content_h"], "view_h": st["scroll_rect"][3],
+           "screens": round(st["content_h"] / st["scroll_rect"][3], 2), "frames": len(st["frames"])}
+    return out
+
+
+def cmd_count(prefix):
+    m = json.load(open(prefix + ".json", encoding="utf-8"))
+    for k in ("closed", "open"):
+        if k in m:
+            print(k, json.dumps(count_state(m[k])))
+    if "open" in m:
+        a = {(n["name"], n["text"][:40]): n for n in m["closed"]["nodes"]}
+        b = {(n["name"], n["text"][:40]): n for n in m["open"]["nodes"]}
+        new = [k for k in b if k not in a]
+        gone = [k for k in a if k not in b]
+        moved = [(k, round(b[k]["x"] - a[k]["x"]), round(b[k]["y"] - a[k]["y"])) for k in a if k in b and (abs(b[k]["y"] - a[k]["y"]) > 1 or abs(b[k]["x"] - a[k]["x"]) > 1)]
+        print("appeared:", len(new), [k[1].replace("\n", " / ") for k in new][:14])
+        print("gone:", len(gone), [k[1].replace("\n", " / ") for k in gone][:8])
+        print("moved:", len(moved), "of", len(a))
+        dys = sorted(set((dx, dy) for _, dx, dy in moved))
+        print("distinct shifts (dx,dy):", dys[:20])
+        for k, dx, dy in moved[:60]:
+            print("   ", dx, dy, k[0], "|", k[1].replace("\n", " / "))
+    if len(sys.argv) > 3 and sys.argv[3] == "dump":
+        for n in m["closed"]["nodes"]:
+            print(n["cls"][0], n["fs"], n["col"], n["lines"], round(n["y"]), n["name"], "|", n["text"].replace("\n", " / ")[:110], "|", n["path"][:60])
+
+
+def stitch(prefix, key, meta):
+    st = meta[key]
+    d = os.path.dirname(prefix)
+    frames = [(Image.open(os.path.join(d, f["file"])).convert("RGB"), f["scroll"]) for f in st["frames"]]
+    W, H = frames[0][0].size
+    r = st["scroll_rect"]
+    scale = W / (r[2] + 2 * r[0])
+    sx, sy, sw, sh = [v * scale for v in r]
+    sy, sh = int(round(sy)), int(round(sh))
+    parts = [frames[0][0].crop((0, 0, W, sy))]
+    covered = 0
+    marks = []
+    y_out = sy
+    for img, s in frames:
+        s = int(round(s * scale))
+        start = max(covered, s)
+        end = s + sh
+        if end <= start:
+            continue
+        parts.append(img.crop((0, sy + (start - s), W, sy + sh)))
+        covered = end
+    parts.append(frames[-1][0].crop((0, sy + sh, W, H)))
+    total = sum(p.size[1] for p in parts)
+    out = Image.new("RGB", (W, total), BG)
+    y = 0
+    for p in parts:
+        out.paste(p, (0, y))
+        y += p.size[1]
+    return out, sy, sh, H
+
+
+def cmd_tall(prefix, outp, title):
+    meta = json.load(open(prefix + ".json", encoding="utf-8"))
+    cols = []
+    for key, lab in (("closed", "No tag picked"), ("open", "A tag picked: the Who tags cards arrive")):
+        if key in meta:
+            img, sy, sh, H = stitch(prefix, key, meta)
+            c = count_state(meta[key])
+            cols.append((img, lab, sy, sh, H, c))
+    gut = 150
+    pad = 30
+    top = 120
+    W = pad + sum(gut + c[0].size[0] + pad for c in cols)
+    Hh = top + max(c[0].size[1] for c in cols) + pad
+    board = Image.new("RGB", (W, Hh), (34, 33, 30))
+    dr = ImageDraw.Draw(board)
+    dr.text((pad, 18), title, font=font(26, True), fill=INK)
+    x = pad
+    for img, lab, sy, sh, H, c in cols:
+        dr.text((x + gut, 62), lab, font=font(17, True), fill=INK)
+        dr.text((x + gut, 86), "%d buttons, %d words, %.1f phone screens of scroll" % (c["buttons"], c["words"], c["screens"]), font=font(14), fill=MUTED)
+        board.paste(img, (x + gut, top))
+        # one phone screen at a time: the part of the list each screen shows
+        n = 0
+        yy = sy
+        while yy < img.size[1] - (H - sy - sh) - 2:
+            n += 1
+            Y = top + yy
+            dr.line((x + 8, Y, x + gut + img.size[0], Y), fill=HOT, width=2)
+            dr.text((x + 8, Y + 6), "Screen %d" % n, font=font(16, True), fill=HOT)
+            dr.text((x + 8, Y + 28), "starts here", font=font(13), fill=HOT)
+            yy += sh
+        x += gut + img.size[0] + pad
+    board.save(outp)
+    print("wrote", outp, board.size)
+
+
+def cmd_pair(outp, title, items, stack=False):
+    ims = []
+    for it in items:
+        lab, f = it.split("=", 1)
+        ims.append((lab, Image.open(f).convert("RGB")))
+    pad = 30
+    top = 80
+    if stack:
+        W = pad * 2 + max(i.size[0] for _, i in ims)
+        Hh = top + sum(i.size[1] + 40 + pad for _, i in ims)
+    else:
+        W = pad + sum(i.size[0] + pad for _, i in ims)
+        Hh = top + 40 + max(i.size[1] for _, i in ims) + pad
+    board = Image.new("RGB", (W, Hh), (34, 33, 30))
+    dr = ImageDraw.Draw(board)
+    dr.text((pad, 18), title, font=font(26, True), fill=INK)
+    x, y = pad, top
+    for lab, im in ims:
+        dr.text((x, y + 8), lab, font=font(18, True), fill=INK)
+        board.paste(im, (x, y + 40))
+        if stack:
+            y += im.size[1] + 40 + pad
+        else:
+            x += im.size[0] + pad
+    board.save(outp)
+    print("wrote", outp, board.size)
+
+
+if __name__ == "__main__":
+    c = sys.argv[1]
+    if c == "count":
+        cmd_count(sys.argv[2])
+    elif c == "tall":
+        cmd_tall(sys.argv[2], sys.argv[3], sys.argv[4])
+    elif c == "pair":
+        args = sys.argv[2:]
+        stack = "--stack" in args
+        args = [a for a in args if a != "--stack"]
+        cmd_pair(args[0], args[1], args[2:], stack)
diff --git a/tools/visual/break_proto.gd b/tools/visual/break_proto.gd
new file mode 100644
index 000000000..8d5c672f7
--- /dev/null
+++ b/tools/visual/break_proto.gd
@@ -0,0 +1,504 @@
+extends RefCounted
+## THROWAWAY (breakaudit, 2026-10-13): three layouts of the half-time break for the
+## director to choose between. Not wired to the sim: each takes the real blocks
+## off the real break (so the choices, cards and words are the game's own) and
+## lays them out differently. Never shipped.
+
+const ROW_H := 46.0
+
+
+static func shots(proto: String, wide: bool) -> Array:
+	if wide:
+		return ["pc"]
+	match proto:
+		"A":
+			return ["landing", "tag"]
+		"B":
+			return ["landing", "matchups", "contest"]
+		"C":
+			return ["landing", "all"]
+	return []
+
+
+static func build(scene, proto: String, shot: String, wide: bool) -> void:
+	var tree: SceneTree = scene.get_tree()
+	var gs = tree.root.get_node("GameState")
+	var db = tree.root.get_node("GameDB")
+	var sim = gs.pending_sim
+	var me: int = scene._my_side
+	scene._coach_overlay = null
+	scene._show_coach_box()
+	var real: Control = scene._coach_overlay
+	for i in range(8):
+		await tree.process_frame
+	# The same state in every picture: at half time the coach has just put a tag on.
+	var tag_id := ""
+	var tp: Node = real.find_child("TagPicker", true, false)
+	if tp != null:
+		for b in tp.find_children("TagPickerGrid_*", "Button", true, false):
+			if str(b.name) != "TagPickerGrid_":
+				tag_id = str(b.name).trim_prefix("TagPickerGrid_")
+				(b as Button).emit_signal("pressed")
+				break
+	for i in range(8):
+		await tree.process_frame
+	real.visible = false
+
+	var d := _answers(scene, sim, db, me, tag_id)
+	match proto + "_" + shot:
+		"A_landing":
+			_a_landing(scene, real, d)
+		"A_tag":
+			_a_landing(scene, real, d)
+			_call_sheet(scene, real, d, "tag")
+		"A_pc":
+			_pc(scene, real, d, false)
+		"B_landing":
+			_b_phone(scene, real, d, "summary")
+		"B_matchups":
+			_b_phone(scene, real, d, "matchups")
+		"B_contest":
+			_b_phone(scene, real, d, "contest")
+		"B_pc":
+			_b_pc(scene, real, d)
+		"C_landing":
+			_c_landing(scene, real, d)
+		"C_all":
+			_c_landing(scene, real, d)
+			_all_sheet(scene, d)
+		"C_pc":
+			_pc(scene, real, d, true)
+
+
+# --------------------------------------------------------------------------
+# What each call's one line says, from the real match
+# --------------------------------------------------------------------------
+static func _short(full: String) -> String:
+	var parts := full.split(" ", false, 1)
+	if parts.size() < 2:
+		return full
+	return "%s. %s" % [parts[0].left(1), parts[1]]
+
+
+static func _answers(scene, sim, db, me: int, tag_id: String) -> Dictionary:
+	var d := {}
+	var plan_key := str(scene._current_plan(sim))
+	d["plan"] = plan_key
+	for g in scene.GAMEPLANS:
+		if str(g[0]) == plan_key:
+			d["plan"] = str(g[1])
+	d["pep"] = "Stay composed"
+	d["rot"] = str(scene.ROTATION_SHORT.get(str(scene._rotation), "Balanced"))
+	var tagger = sim.get_script().tagger_for(sim.squads[me].ground)
+	var target := str(db.player_display_name_by_id(tag_id, ""))
+	d["tag_target"] = target
+	d["tagger"] = str(db.player_display_name(tagger)) if tagger != null else ""
+	d["tag"] = "No tag" if target == "" else "%s, by %s" % [_short(target), _short(str(d["tagger"]))]
+	var duels: Dictionary = sim.duels[me]
+	var mu := PackedStringArray()
+	for fid in duels:
+		mu.append("%s on %s" % [_short(MatchNotes._pname(str(duels[fid]))).get_slice(". ", 1), _short(MatchNotes._pname(str(fid))).get_slice(". ", 1)])
+	d["mu_n"] = mu.size()
+	d["mu"] = "None named" if mu.is_empty() else ", ".join(mu.slice(0, 2)) + ("" if mu.size() <= 2 else " +%d" % (mu.size() - 2))
+	d["mu_first"] = ""
+	d["mu_first_row"] = ""
+	for fid in duels:
+		d["mu_first"] = str(scene._matchup_text(str(fid), str(duels[fid]), sim.current_quarter))
+		d["mu_first_row"] = "%s on %s" % [_short(MatchNotes._pname(str(duels[fid]))), _short(MatchNotes._pname(str(fid)))]
+		break
+	var opp_spare: Dictionary = sim._roaming_interceptor(1 - me)
+	d["minder"] = "They have no loose defender" if opp_spare.is_empty() else "No one on %s" % _short(str(db.player_display_name(opp_spare)))
+	var loose := str(sim.interceptor[me])
+	d["loose"] = "No loose defender" if loose == "" else _short(str(db.player_display_name_by_id(loose, "")))
+	d["pt"] = "No one"
+	# Best so far, one man a side.
+	var best := PackedStringArray()
+	for side in [me, 1 - me]:
+		var s: Array = MatchNotes.standouts(scene._res, side, 1)
+		if not s.is_empty():
+			best.append("%s %s" % [_short(str(s[0]["name"])), MatchNotes.rating_text(float(s[0]["rating"]))])
+	d["best"] = "  ·  ".join(best)
+	# Their busiest midfielder so far (a fact for the tag question).
+	var top_name := ""
+	var top_d := -1
+	for r in scene._roster_side(1 - me):
+		if not scene._taggable_now(sim, r):
+			continue
+		var st: Dictionary = (scene._res.get("players", {}) as Dictionary).get(str(r["id"]), {})
+		var n := int(float(st.get("disposals", 0.0)))
+		if n > top_d:
+			top_d = n
+			top_name = str(db.player_display_name(r))
+	d["top_mid"] = top_name
+	d["top_mid_line"] = "%s has had %d disposals for them, more than any other midfielder." % [top_name, top_d]
+	d["legs"] = str(MatchNotes.legs_line(scene._group_energy(me), scene._group_energy(1 - me)))
+	return d
+
+
+static func _rows_spec(d: Dictionary) -> Array:
+	# key, label, answer, changed this break
+	return [
+		["plan", "Game plan", d["plan"], false],
+		["pep", "Pep talk", d["pep"], false],
+		["rot", "Rotations", d["rot"], false],
+		["tag", "Tag", d["tag"], str(d["tag_target"]) != ""],
+		["mu", "Key match-ups", d["mu"], false],
+		["minder", "Defensive forward", d["minder"], false],
+		["loose", "Loose interceptor", d["loose"], false],
+		["pt", "Play through (forward, midfield, back)", d["pt"], false],
+	]
+
+
+# --------------------------------------------------------------------------
+# Pieces
+# --------------------------------------------------------------------------
+static func _shell(scene, node_name: String, max_w: float) -> Dictionary:
+	var box: Dictionary = UiKit.modal_box(scene, max_w, 0.0, scene._wash())
+	(box["overlay"] as Control).name = node_name
+	return box
+
+
+static func _band(scene, box: Dictionary, wide: bool) -> void:
+	var res: Dictionary = scene._res
+	var bv: BoxContainer = UiKit.hbox(16) if wide else UiKit.vbox(2)
+	var band := ClubDuel.band(str(res["home"]), str(res["away"]), bv, 14)
+	(box["body"] as Control).add_child(band)
+	var title := UiKit.heading("Half time", UiKit.H1)
+	if wide:
+		title.autowrap_mode = TextServer.AUTOWRAP_OFF
+	ClubDuel.on_colour(title)
+	bv.add_child(title)
+	var sc := UiKit.lbl(MatchNotes.break_score(str(res["home"]), str(res["away"]),
+			res.get("goals", [0, 0]), res.get("behinds", [0, 0])), UiKit.NAME, UiKit.TEXT, true)
+	sc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	ClubDuel.on_colour(sc)
+	if wide:
+		sc.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		sc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	bv.add_child(sc)
+
+
+static func _footer(box: Dictionary, wide: bool) -> void:
+	var start := UiKit.btn("Start quarter", UiKit.HEADING, true)
+	start.custom_minimum_size = Vector2(0, 48)
+	var stats := UiKit.text_action("Match stats", UiKit.BODY)
+	var skip := UiKit.text_action("Skip to full time", UiKit.BODY)
+	var foot: Control = box["footer"]
+	if wide:
+		var acts := UiKit.hbox(12)
+		acts.alignment = BoxContainer.ALIGNMENT_END
+		stats.custom_minimum_size = Vector2(180, 48)
+		skip.custom_minimum_size = Vector2(220, 48)
+		start.custom_minimum_size = Vector2(300, 48)
+		for b in [stats, skip, start]:
+			acts.add_child(b)
+		foot.add_child(acts)
+	else:
+		foot.add_child(start)
+		var words := UiKit.hbox(8)
+		words.alignment = BoxContainer.ALIGNMENT_CENTER
+		stats.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		skip.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		words.add_child(stats)
+		words.add_child(skip)
+		foot.add_child(words)
+
+
+static func _take(real: Node, nm: String, parent_block := false) -> Control:
+	var n: Control = real.find_child(nm, true, false)
+	if n == null:
+		return null
+	if parent_block:
+		n = n.get_parent()
+	n.get_parent().remove_child(n)
+	n.visible = true
+	return n
+
+
+static func _add(v: Control, c: Control) -> void:
+	if c != null:
+		v.add_child(c)
+
+
+## The quarter just played and what your calls did: the game's own lines.
+static func _feedback(v: Control, real: Node) -> void:
+	v.add_child(UiKit.section("Second quarter"))
+	_add(v, _take(real, "QuarterFacts"))
+	var did := _take(real, "CallsDid")
+	if did != null:
+		v.add_child(UiKit.spacer(2))
+		v.add_child(UiKit.section("What your calls did"))
+		v.add_child(did)
+
+
+## One call as one row: what it is, quietly, and its answer in bold under it.
+## A call changed at this break carries your club's colour down its edge and
+## says so. The whole row is the tap.
+static func _row(label: String, answer: String, changed := false, chosen := false) -> Button:
+	var b := UiKit.text_action("", UiKit.NAME)
+	b.custom_minimum_size = Vector2(0, ROW_H)
+	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	if chosen:
+		var sb := UiKit.style(Color.TRANSPARENT, 8, UiKit.RADIUS, UiKit.TEXT)
+		sb.set_border_width_all(2)
+		for state in ["normal", "hover", "pressed", "hover_pressed", "focus"]:
+			b.add_theme_stylebox_override(state, sb)
+	var h := UiKit.hbox(8)
+	h.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	h.offset_left = 2.0
+	h.offset_right = -6.0
+	var rule := ColorRect.new()
+	rule.custom_minimum_size = Vector2(4, 0)
+	rule.color = UiKit.club_vivid(str(GameState.my_club), UiKit.SURFACE) if changed else Color.TRANSPARENT
+	h.add_child(rule)
+	var col := UiKit.vbox(0)
+	col.alignment = BoxContainer.ALIGNMENT_CENTER
+	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	var top := UiKit.hbox(6)
+	top.add_child(UiKit.line(label, UiKit.SECONDARY, UiKit.MUTED))
+	if changed:
+		top.add_child(UiKit.line("· changed this break", UiKit.SECONDARY, UiKit.TEXT))
+	col.add_child(top)
+	var a := UiKit.ellipsis(answer, UiKit.NAME, UiKit.TEXT, true)
+	col.add_child(a)
+	h.add_child(col)
+	var chev := UiKit.line("›", UiKit.HEADING, UiKit.MUTED)
+	chev.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	chev.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	h.add_child(chev)
+	b.add_child(h)
+	for n in b.find_children("*", "Control", true, false):
+		(n as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
+	return b
+
+
+static func _rows(d: Dictionary, chosen := "") -> VBoxContainer:
+	var v := UiKit.vbox(0)
+	v.name = "CallRows"
+	for r in _rows_spec(d):
+		v.add_child(_row(str(r[1]), str(r[2]), bool(r[3]), str(r[0]) == chosen))
+		v.add_child(UiKit.rule())
+	return v
+
+
+static func _note(text: String, strong := false) -> Label:
+	var l := UiKit.lbl(text, UiKit.BODY if strong else UiKit.SMALL, UiKit.TEXT if strong else UiKit.MUTED)
+	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	return l
+
+
+## Everything one call needs, in one place: the fact that informs it, the
+## choices, any follow-up choice, and the rule in a line.
+static func _call_content(v: Control, real: Node, d: Dictionary, key: String) -> void:
+	match key:
+		"tag":
+			v.add_child(_note(str(d["top_mid_line"]), true))
+			_add(v, _take(real, "TagPicker", true))
+			_add(v, _take(real, "TaggerPicker", true))
+			_add(v, _take(real, "TagNote"))
+		"plan":
+			_add(v, _take(real, "PlanPicker", true))
+			_add(v, _take(real, "PlanNote"))
+		"pep":
+			_add(v, _take(real, "PepPicker", true))
+			_add(v, _take(real, "PepNote"))
+		"rot":
+			_add(v, _take(real, "RotationsBlock"))
+			_add(v, _take(real, "RotationNote"))
+			_add(v, _take(real, "LegsView"))
+		"mu":
+			_add(v, _take(real, "BreakMatchups"))
+		"minder":
+			_add(v, _take(real, "MinderBlock"))
+		"loose":
+			_add(v, _take(real, "LooseBlock"))
+			v.add_child(_note("He leaves his direct man to attack aerial balls. Another defender covers where possible; if he flies and loses, space opens behind him."))
+		"pt":
+			for slot in ["focus_fwd", "focus_mid", "focus_def"]:
+				_add(v, _take(real, "FocusPicker_" + slot, true))
+
+
+# --------------------------------------------------------------------------
+# A. One line each
+# --------------------------------------------------------------------------
+static func _a_landing(scene, real: Node, d: Dictionary) -> void:
+	var box := _shell(scene, "ProtoMain", 640.0)
+	var v: VBoxContainer = box["body"]
+	_band(scene, box, false)
+	_feedback(v, real)
+	v.add_child(UiKit.spacer(2))
+	v.add_child(UiKit.section("Next quarter"))
+	var rows := _rows(d)
+	rows.add_child(_row("Best so far", str(d["best"])))
+	v.add_child(rows)
+	_footer(box, false)
+
+
+static func _call_sheet(scene, real: Node, d: Dictionary, key: String) -> void:
+	var box := _shell(scene, "ProtoSheet", 640.0)
+	var v: VBoxContainer = box["body"]
+	var titles := {"tag": "Tag"}
+	v.add_child(UiKit.heading(str(titles.get(key, key)), UiKit.H1))
+	_call_content(v, real, d, key)
+	# The sheet's own heading says what it is: the block's small one goes.
+	for h in v.find_children("CallHeading", "Label", true, false):
+		if (h as Label).text == "Tag":
+			(h as Label).visible = false
+	var done := UiKit.btn("Done", UiKit.HEADING, true)
+	done.custom_minimum_size = Vector2(0, 48)
+	(box["footer"] as Control).add_child(done)
+
+
+static func _all_sheet(scene, d: Dictionary) -> void:
+	var box := _shell(scene, "ProtoSheet", 640.0)
+	var v: VBoxContainer = box["body"]
+	v.add_child(UiKit.heading("All calls", UiKit.H1))
+	v.add_child(_rows(d))
+	var done := UiKit.btn("Done", UiKit.HEADING, true)
+	done.custom_minimum_size = Vector2(0, 48)
+	(box["footer"] as Control).add_child(done)
+
+
+# --------------------------------------------------------------------------
+# C. What needs you (phone landing); A and C share the PC layout
+# --------------------------------------------------------------------------
+static func _questions(v: Control, d: Dictionary, chosen := "") -> void:
+	v.add_child(UiKit.section("From the first half"))
+	var why := _note("Always the same three: their busiest midfielder, your first key match-up, both sides' legs.")
+	v.add_child(why)
+	var qs := [
+		[str(d["top_mid_line"]), "Tag", str(d["tag"]), str(d["tag_target"]) != "", "tag"],
+		[str(d["mu_first"]), "Match-up", str(d["mu_first_row"]), false, "mu"],
+		[str(d["legs"]), "Rotations", str(d["rot"]), false, "rot"],
+	]
+	for q in qs:
+		if str(q[0]) == "":
+			continue
+		v.add_child(UiKit.spacer(2))
+		v.add_child(_note(str(q[0]), true))
+		v.add_child(_row(str(q[1]), str(q[2]), bool(q[3]), str(q[4]) == chosen))
+		v.add_child(UiKit.rule())
+
+
+static func _c_landing(scene, real: Node, d: Dictionary) -> void:
+	var box := _shell(scene, "ProtoMain", 640.0)
+	var v: VBoxContainer = box["body"]
+	_band(scene, box, false)
+	_feedback(v, real)
+	v.add_child(UiKit.spacer(2))
+	_questions(v, d)
+	v.add_child(_row("All calls", "8 calls  ·  1 changed this break"))
+	v.add_child(UiKit.rule())
+	v.add_child(_row("Best so far", str(d["best"])))
+	_footer(box, false)
+
+
+static func _pc(scene, real: Node, d: Dictionary, with_questions: bool) -> void:
+	scene._pc_break = true
+	var box := _shell(scene, "ProtoMain", minf(UiKit.view_width(scene) - 48.0, 1560.0))
+	var v: VBoxContainer = box["body"]
+	_band(scene, box, true)
+	var cols := UiKit.hbox(28)
+	v.add_child(cols)
+	var a := UiKit.vbox(6)
+	var b := UiKit.vbox(6)
+	var c := UiKit.vbox(6)
+	for col in [a, b, c]:
+		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		col.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
+		cols.add_child(col)
+	a.size_flags_stretch_ratio = 1.0
+	b.size_flags_stretch_ratio = 1.0
+	c.size_flags_stretch_ratio = 1.15
+	_feedback(a, real)
+	a.add_child(UiKit.spacer(4))
+	if with_questions:
+		_questions(a, d, "tag")
+		b.add_child(UiKit.section("All calls"))
+		b.add_child(_rows(d, "tag"))
+		b.add_child(_row("Best so far", str(d["best"])))
+	else:
+		_add(a, _take(real, "BestSoFar"))
+		b.add_child(UiKit.section("Next quarter"))
+		b.add_child(_rows(d, "tag"))
+	c.add_child(UiKit.section("Tag"))
+	_call_content(c, real, d, "tag")
+	for h in c.find_children("CallHeading", "Label", true, false):
+		if (h as Label).text == "Tag":
+			(h as Label).visible = false
+	_footer(box, true)
+
+
+# --------------------------------------------------------------------------
+# B. Grouped pages
+# --------------------------------------------------------------------------
+static func _who_tags_line(d: Dictionary) -> Control:
+	var row := UiKit.hbox(8)
+	var col := UiKit.vbox(0)
+	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	col.add_child(UiKit.line("Who tags", UiKit.SECONDARY, UiKit.MUTED))
+	col.add_child(UiKit.ellipsis("%s, your assistant's pick" % str(d["tagger"]), UiKit.NAME, UiKit.TEXT, true))
+	row.add_child(col)
+	row.add_child(UiKit.text_action("Change", UiKit.SECONDARY))
+	return row
+
+
+static func _b_page(v: Control, real: Node, d: Dictionary, page: String, wide: bool) -> void:
+	match page:
+		"summary":
+			_feedback(v, real)
+			_add(v, _take(real, "LegsView"))
+			v.add_child(UiKit.spacer(2))
+			_add(v, _take(real, "BestSoFar"))
+		"contest":
+			_add(v, _take(real, "PlanPicker", true))
+			_add(v, _take(real, "PlanNote"))
+			_add(v, _take(real, "PepPicker", true))
+			_add(v, _take(real, "PepNote"))
+			_add(v, _take(real, "RotationsBlock"))
+			_add(v, _take(real, "RotationNote"))
+			if not wide:
+				_add(v, _take(real, "LegsView"))
+		"matchups":
+			_add(v, _take(real, "BreakMatchups"))
+			_add(v, _take(real, "TagPicker", true))
+			v.add_child(_who_tags_line(d))
+			_add(v, _take(real, "MinderBlock"))
+			_add(v, _take(real, "LooseBlock"))
+		"through":
+			for slot in ["focus_fwd", "focus_mid", "focus_def"]:
+				_add(v, _take(real, "FocusPicker_" + slot, true))
+
+
+static func _b_phone(scene, real: Node, d: Dictionary, page: String) -> void:
+	var box := _shell(scene, "ProtoMain", 640.0)
+	var v: VBoxContainer = box["body"]
+	_band(scene, box, false)
+	var tabs := UiKit.hbox(0)
+	for t in [["summary", "The half"], ["contest", "The contest"], ["matchups", "Match-ups"], ["through", "Play through"]]:
+		var tb := UiKit.tab(str(t[1]), str(t[0]) == page)
+		tb.custom_minimum_size = Vector2(0, 44)
+		if str(t[0]) == page:
+			tabs.set_meta("current", tb)
+		tabs.add_child(tb)
+	v.add_child(UiKit.strip(tabs))
+	_b_page(v, real, d, page, false)
+	_footer(box, false)
+
+
+static func _b_pc(scene, real: Node, d: Dictionary) -> void:
+	scene._pc_break = true
+	var box := _shell(scene, "ProtoMain", minf(UiKit.view_width(scene) - 48.0, 1560.0))
+	var v: VBoxContainer = box["body"]
+	_band(scene, box, true)
+	var cols := UiKit.hbox(24)
+	v.add_child(cols)
+	for t in [["summary", ""], ["contest", "The contest"], ["matchups", "Match-ups"], ["through", "Play through"]]:
+		var col := UiKit.vbox(6)
+		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		col.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
+		cols.add_child(col)
+		if str(t[1]) != "":
+			col.add_child(UiKit.section(str(t[1])))
+		_b_page(col, real, d, str(t[0]), true)
+	_footer(box, true)
diff --git a/tools/visual/capture_break_audit.gd b/tools/visual/capture_break_audit.gd
new file mode 100644
index 000000000..2a23aad5a
--- /dev/null
+++ b/tools/visual/capture_break_audit.gd
@@ -0,0 +1,218 @@
+extends SceneTree
+## THROWAWAY (breakaudit, 2026-10-13): captures of the break screen as it is, and
+## of three streamlining prototypes, for the director's choice. Not product code.
+##   --size WxH  --q 1|3  --out prefix  --proto A|B|C (omit for today's screen)
+## Fremantle (you) v Melbourne, dark. Writes PNG frames and <out>.json (every
+## visible label and button, the scroll geometry, where blocks sat before and
+## after a tag is picked).
+
+var _w := 390
+var _h := 844
+
+
+func _initialize() -> void:
+	_run.call_deferred()
+
+
+func _run() -> void:
+	var out := "break"
+	var q := 1
+	var proto := ""
+	var a := OS.get_cmdline_user_args()
+	for i in range(a.size()):
+		match str(a[i]):
+			"--out":
+				out = str(a[i + 1])
+			"--size":
+				var wh := str(a[i + 1]).split("x")
+				_w = int(wh[0])
+				_h = int(wh[1])
+			"--q":
+				q = int(a[i + 1])
+			"--proto":
+				proto = str(a[i + 1])
+	await process_frame
+	var state = root.get_node("GameState")
+	var db = root.get_node("GameDB")
+	var UK = load("res://scripts/ui/UiKit.gd")
+	state.autosave_enabled = false
+	state.save_path = "user://capture_breakaudit.save"
+	state.settings_path = "user://capture_breakaudit.cfg"
+	var club := "FRE"
+	var vs := "MEL"
+	var tries := 0
+	while true:
+		state.reset()
+		state.career_seed = 2026 + tries
+		state.replay_seed = 2026 + tries
+		state.set_setting("seen_training_intro", true)
+		state.start_season(club, db.club_list(club))
+		if not state.prepare_interactive_match():
+			push_error("no match")
+			quit(1)
+			return
+		var s0 = state.pending_sim
+		var h := str(s0.squads[0].code)
+		var w := str(s0.squads[1].code)
+		if (h == club and w == vs) or (h == vs and w == club) or tries > 80:
+			break
+		tries += 1
+	var sim = state.pending_sim
+	var me := int(sim.moment_side)
+	print("match: ", sim.squads[0].code, " v ", sim.squads[1].code, " seed ", state.career_seed, " me ", me)
+	if q >= 2:
+		# A first half with a call in it, so "What your calls did" has something to say.
+		var t: Dictionary = (sim.tactics[me] as Dictionary).duplicate()
+		t["gameplan"] = "defensive"
+		sim.set_tactics(me, t)
+		for i in range(q - 1):
+			sim.run_quarter()
+	UK.apply_appearance("dark")
+	if _w >= 760:
+		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
+		DisplayServer.window_set_size(Vector2i(_w, _h))
+		for i in range(10):
+			await process_frame
+		var factor := float(_w) / maxf(1.0, root.get_visible_rect().size.x)
+		if factor > 1.05:
+			DisplayServer.window_set_size(Vector2i(int(_w * factor), int(_h * factor)))
+			for i in range(10):
+				await process_frame
+		print("visible ", root.get_visible_rect().size)
+	else:
+		root.size = Vector2i(_w, _h)
+		DisplayServer.window_set_size(Vector2i(_w, _h))
+	var scene = load("res://scenes/MatchScene.tscn").instantiate()
+	root.add_child(scene)
+	await _frames(14)
+	if proto != "":
+		var P = load("res://tools/visual/break_proto.gd")
+		var shots: Array = P.shots(proto, _w >= 760)
+		for sh in shots:
+			var old: Node = scene.find_child("CoachBox", true, false)
+			if old != null:
+				old.get_parent().remove_child(old)
+				old.queue_free()
+			for o in scene.find_children("Proto*", "Control", false, false):
+				scene.remove_child(o)
+				o.queue_free()
+			await _frames(2)
+			await P.build(scene, proto, str(sh), _w >= 760)
+			await _frames(12)
+			_save("%s_%s.png" % [out, str(sh)])
+			var dump := {"nodes": _dump(scene)}
+			var f := FileAccess.open("%s_%s.json" % [out, str(sh)], FileAccess.WRITE)
+			f.store_string(JSON.stringify(dump, " "))
+			f.close()
+		quit()
+		return
+	var meta := {"size": [_w, _h], "q": q}
+	var box: Control = scene.find_child("CoachBox", true, false)
+	meta["closed"] = await _state(box, out + "_closed")
+	# A tag picked: the Who tags cards arrive under it.
+	var tagged: Button = null
+	var tp: Node = scene.find_child("TagPicker", true, false)
+	if tp != null:
+		for b in tp.find_children("TagPickerGrid_*", "Button", true, false):
+			if str(b.name) != "TagPickerGrid_":
+				tagged = b
+				break
+	if tagged != null:
+		tagged.emit_signal("pressed")
+		await _frames(12)
+		meta["open"] = await _state(box, out + "_open")
+	var f2 := FileAccess.open(out + ".json", FileAccess.WRITE)
+	f2.store_string(JSON.stringify(meta, " "))
+	f2.close()
+	quit()
+
+
+## One state of the screen: every scroll position as a frame, and what is on it.
+func _state(box: Control, prefix: String) -> Dictionary:
+	var sc: ScrollContainer = null
+	for n in box.find_children("*", "ScrollContainer", true, false):
+		if (n as ScrollContainer).vertical_scroll_mode != ScrollContainer.SCROLL_MODE_DISABLED:
+			sc = n
+			break
+	var info := {}
+	var content: Control = sc.get_child(0) if sc != null and sc.get_child_count() > 0 else null
+	for c in sc.get_children():
+		if c is Control and not (c is ScrollBar):
+			content = c
+	var view_h := sc.size.y
+	var content_h := content.size.y
+	info["scroll_rect"] = [sc.global_position.x, sc.global_position.y, sc.size.x, sc.size.y]
+	info["content_h"] = content_h
+	info["frames"] = []
+	sc.scroll_vertical = 0
+	await _frames(3)
+	info["nodes"] = _dump(box, sc)
+	var y := 0.0
+	var i := 0
+	var maxy := maxf(0.0, content_h - view_h)
+	while true:
+		sc.scroll_vertical = int(minf(y, maxy))
+		await _frames(3)
+		var p := "%s_%02d.png" % [prefix, i]
+		_save(p)
+		(info["frames"] as Array).append({"file": p.get_file(), "scroll": sc.scroll_vertical})
+		if y >= maxy:
+			break
+		y += view_h
+		i += 1
+	sc.scroll_vertical = 0
+	await _frames(2)
+	return info
+
+
+## Every visible label and button: its words, where it sits (content
+## coordinates when inside the scroll), its size of type and its ink.
+func _dump(rootn: Node, sc: ScrollContainer = null) -> Array:
+	var out: Array = []
+	for n in rootn.find_children("*", "Control", true, false):
+		var c := n as Control
+		if not c.is_visible_in_tree():
+			continue
+		if not (c is Label or c is Button):
+			continue
+		var text := ""
+		var lines := 1
+		if c is Label:
+			text = (c as Label).text
+			lines = (c as Label).get_line_count()
+		else:
+			text = str(c.get_meta("card_text", (c as Button).text))
+			if text == "" and (c as Button).tooltip_text != "":
+				text = (c as Button).tooltip_text
+		if text.strip_edges() == "":
+			continue
+		var in_scroll := sc != null and sc.is_ancestor_of(c)
+		var path := PackedStringArray()
+		var p: Node = c.get_parent()
+		var inside_button := false
+		while p != null and p != rootn:
+			if p is Button:
+				inside_button = true
+			if not str(p.name).begins_with("@"):
+				path.append(str(p.name))
+			p = p.get_parent()
+		var col := c.get_theme_color("font_color")
+		out.append({"cls": "Button" if c is Button else "Label", "name": str(c.name), "text": text, "lines": lines,
+				"x": c.global_position.x, "y": c.global_position.y + (float(sc.scroll_vertical) if in_scroll else 0.0),
+				"w": c.size.x, "h": c.size.y, "fs": c.get_theme_font_size("font_size"), "col": col.to_html(false),
+				"in_scroll": in_scroll, "in_button": inside_button, "disabled": c is Button and (c as Button).disabled,
+				"path": "/".join(path)})
+	return out
+
+
+func _frames(n: int) -> void:
+	for i in range(n):
+		await process_frame
+
+
+func _save(path: String) -> void:
+	var img := root.get_viewport().get_texture().get_image()
+	img.convert(Image.FORMAT_RGBA8)
+	if img.save_png(path) != OK:
+		push_error("could not save " + path)
+	print("wrote ", path)
diff --git a/tools/visual/run_cap.sh b/tools/visual/run_cap.sh
new file mode 100644
index 000000000..333ccc799
--- /dev/null
+++ b/tools/visual/run_cap.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# One claim, several short capture runs, one release. Usage: run_cap.sh TAG "args1" "args2" ...
+# Each args string is passed after "--" to tools/visual/capture_break_audit.gd.
+SLOT="C:/Users/DANTE/AppData/Local/Temp/claude/C--Users-DANTE-Documents-GitHub-Afl-auto-battler/59d453d8-7ee5-4855-b721-a96f9ef4efcf/scratchpad/godot_slot.sh"
+GODOT="C:/Users/DANTE/Desktop/Godot_v4.7.2-stable_win64.exe/Godot_v4.7.2-stable_win64_console.exe"
+WT="C:/Users/DANTE/Documents/GitHub/afl-breakaudit"
+SCR="$(cd "$(dirname "$0")" && pwd)"
+tag="$1"; shift
+slot=""
+for i in $(seq 1 45); do
+  slot=$(bash "$SLOT" claim breakaudit) && break
+  slot=""
+  sleep 20
+done
+[ -z "$slot" ] && { echo "NO SLOT after 15 min"; exit 1; }
+trap 'bash "$SLOT" release $slot' EXIT
+export APPDATA="$SCR/appdata_$tag"
+mkdir -p "$APPDATA" "$WT/_cap"
+cd "$WT"
+if [ ! -d .godot ]; then
+  "$GODOT" --headless --import --path . > "$SCR/import_$tag.log" 2>&1
+  echo "import exit $?"
+fi
+n=0
+for args in "$@"; do
+  n=$((n+1))
+  # shellcheck disable=SC2086
+  timeout 240 "$GODOT" --path . -s tools/visual/capture_break_audit.gd -- $args > "$SCR/cap_${tag}_$n.log" 2>&1
+  echo "run $n ($args) exit $?"
+  grep -E "SCRIPT ERROR|ERROR:|Parse Error|match:|visible " "$SCR/cap_${tag}_$n.log" | head -12
+done
