+## The week's story cards, the first thing on the page: they are decisions the
+## coach has to make (director, 2026-10-19: "the events are central to the
+## identity of the game and not an after thought"). Null when there are none.
+func _events_block() -> Control:
+	if GameState.season == null or GameState.season.is_season_over() or GameState.week_events.is_empty():
+		return null
+	var v := UiKit.vbox(8)
+	v.name = "WeekEvents"
+	v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	for i in range(GameState.week_events.size()):
+		var ev := _event_card(i)
+		v.add_child(ev)
+		# A question still waiting on the coach: it brightens twice, once.
+		if not bool((GameState.week_events[i] as Dictionary).get("resolved", false)) and not _settled:
+			UiKit.attention(ev)
+	return v
+
+
+## One line of the responses beside the opposition's facts, each named once, in
+## FactOptions order. They are words to tap, not buttons: a tap opens that call
+## on the pre-bounce pane (Play match with the call in view), and the line says so.
+func _response_line(facts: Array, fact_options: Array) -> Control:
+	var picks: Array = []
+	var seen := {}
+	for i in range(mini(facts.size(), fact_options.size())):
+		for o in (fact_options[i] as Array):
+			var key := str(o["plan"]) if str(o["call"]) == "plan" else str(o["call"])
+			if seen.has(key):
+				continue
+			seen[key] = true
+			picks.append({"key": key, "option": o, "fact": str(facts[i]["text"])})
+	if picks.is_empty():
+		return null
+	picks.sort_custom(func(a, b):
+		var ia := FactOptions.ORDER.find(str(a["option"]["call"]))
+		var ib := FactOptions.ORDER.find(str(b["option"]["call"]))
+		if ia != ib:
+			return ia < ib
+		return str(a["option"]["label"]) < str(b["option"]["label"]))
+	var flow := HFlowContainer.new()
+	flow.name = "FactOptionsLine"
+	flow.add_theme_constant_override("h_separation", 12)
+	flow.add_theme_constant_override("v_separation", 0)
+	flow.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	var lead := UiKit.lbl("Answer it before the bounce:", UiKit.SECONDARY, UiKit.TEXT, true)
+	lead.autowrap_mode = TextServer.AUTOWRAP_OFF
+	lead.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	flow.add_child(lead)
+	for pk in picks:
+		var o: Dictionary = pk["option"]
+		var b := UiKit.text_action(str(o["label"]), UiKit.SECONDARY)
+		b.name = "FactOption_" + str(pk["key"])
+		b.set_meta("option", o)
+		var ink := UiKit.club_name_colour(UiKit.club_ink(GameState.my_club))
+		b.add_theme_color_override("font_color", ink)
+		b.add_theme_color_override("font_hover_color", ink)
+		b.tooltip_text = str(o["cost"])
+		b.pressed.connect(_on_fact_option.bind(o, str(pk["fact"])))
+		flow.add_child(b)
+	return flow
+
+
 ## A live MRO sanction can be challenged once before the next round. Keep it
 ## on the weekly hub rather than hiding the decision in the result popup.
 func _tribunal_card() -> Control:
diff --git a/tools/visual/capture_hub_week.gd b/tools/visual/capture_hub_week.gd
new file mode 100644
index 000000000..3cf30aebd
--- /dev/null
+++ b/tools/visual/capture_hub_week.gd
@@ -0,0 +1,70 @@
+extends SceneTree
+## Review capture of the hub's round screen (dark): round 3 with a contract
+## card waiting and the league news. Needs a real renderer:
+##   godot --path . --rendering-method gl_compatibility --script tools/visual/capture_hub_week.gd
+## Environment: CAP_DIR (default "."), CAP_TAG (file prefix, default "hub"),
+## CAP_CLUB (default "FRE"). Writes <tag>_960x540.png and <tag>_390x844.png.
+## A fresh career in a scratch save; never touches a real save.
+
+
+func _initialize() -> void:
+	_run.call_deferred()
+
+
+func _frames(n := 8) -> void:
+	for i in range(n):
+		await process_frame
+
+
+func _env(key: String, fallback: String) -> String:
+	return OS.get_environment(key) if OS.get_environment(key) != "" else fallback
+
+
+func _run() -> void:
+	var dir := _env("CAP_DIR", ".")
+	var tag := _env("CAP_TAG", "hub")
+	var club := _env("CAP_CLUB", "FRE")
+	await process_frame
+	var state = root.get_node("GameState")
+	var db = root.get_node("GameDB")
+	var UK = load("res://scripts/ui/UiKit.gd")
+	state.autosave_enabled = false
+	state.save_path = "user://capture_hub_week.save"
+	state.settings_path = "user://capture_hub_week.cfg"
+	state.reset()
+	state.career_seed = 2026
+	state.replay_seed = 2026
+	state.set_setting("seen_training_intro", true)
+	state.start_season(club, db.club_list(club))
+	state.set_setting("seen_weekly_loop_intro", true)
+	state.tutorials = false
+	UK.apply_appearance("dark")
+	for i in range(2):
+		state.advance()
+	var p: Dictionary = db.club_list(club)[0]
+	var card: Dictionary = state.story_card("contracts_wants_to_extend", p)
+	if not card.is_empty():
+		state.week_events = [card]
+	for size in [Vector2i(960, 540), Vector2i(390, 844)]:
+		root.size = size
+		DisplayServer.window_set_size(size)
+		var bg := ColorRect.new()
+		bg.color = UK.BG
+		bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+		root.add_child(bg)
+		var hub = load("res://scenes/HubScene.tscn").instantiate()
+		root.add_child(hub)
+		await _frames(40)
+		var img := root.get_viewport().get_texture().get_image()
+		img.convert(Image.FORMAT_RGBA8)
+		var path := "%s/%s_%dx%d.png" % [dir, tag, size.x, size.y]
+		img.save_png(path)
+		for s in hub.find_children("*", "ScrollContainer", true, false):
+			var sc := s as ScrollContainer
+			print("scroll max ", sc.get_v_scroll_bar().max_value, " page ", sc.size.y)
+			break
+		print("wrote ", path)
+		hub.queue_free()
+		bg.queue_free()
+		await _frames(4)
+	quit(0)
-- 
