-	match call:
-		"tag":
-			if not who.is_empty():
-				if not _tag_candidate(who):
-					reason = "He plays %s: a tag needs a midfielder." % _where(who)
-			elif theirs.filter(func(p): return _tag_candidate(p)).is_empty():
-				reason = "None of their midfielders is on the ground."
