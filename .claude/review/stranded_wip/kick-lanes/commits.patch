From 57be2f4e9886b990ada832d38fd72a98d9030e32 Mon Sep 17 00:00:00 2001
From: gabebartolo-spec <gabebartolo@gmail.com>
Date: Tue, 10 Nov 2026 19:01:04 +1100
Subject: [PATCH] Kick lanes: the view draws each logged lane; corridor keeps
 its lanes at the boundary (row T2.25)

- MatchDirector._loc aims line kicks 28-36 m wide and switches 22-30 m across,
  landing within LANE_REACH (12 m) of the logged receiver.
- _keep_in(p, lane): Attack Corridor spots come in along the ground only, so the
  radial clamp no longer squeezes a line of three under LANE_GAP.
- Lane test counts kicks only and checks lane_log against tagged kicks.
- Collection-pause cap loosened to the measured 24 (director 2026-11-10,
  "Draw lanes wide").

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/ui/match/MatchDirector.gd | 29 ++++++++++++++++++++++-------
 tests/test_match_game.gd          | 21 ++++++++++++++++-----
 tests/test_match_visual.gd        |  6 +++++-
 3 files changed, 43 insertions(+), 13 deletions(-)

diff --git a/scripts/ui/match/MatchDirector.gd b/scripts/ui/match/MatchDirector.gd
index 4494a1636..2eed7fe74 100644
--- a/scripts/ui/match/MatchDirector.gd
+++ b/scripts/ui/match/MatchDirector.gd
@@ -1061,13 +1061,17 @@ func _loc(k: int) -> Vector2:
 					dy = -src.y * 0.8 + _rng.randf_range(-6.0, 6.0)
 				"switch":
 					# Across to the far wing.
-					dy = -wing * _rng.randf_range(26.0, 36.0) - src.y
+					dy = -wing * _rng.randf_range(22.0, 30.0) - src.y
 				"line":
 					# Along his own boundary line (the clamp below keeps it in play).
-					dy = wing * _rng.randf_range(38.0, 46.0) - src.y
+					dy = wing * _rng.randf_range(28.0, 36.0) - src.y
 				_:
 					if absf(src.y) > 22.0 and roll < 0.1 and _plan_of(int(ev.get("side", 0))) != "attacking":
 						dy = -src.y * 1.3 + _rng.randf_range(-5.0, 5.0)   # a switch of play
+			if lane != "" and a >= 0:
+				# The lane aims the kick; it still lands within LANE_REACH of
+				# the player the log says wins it, so play never waits on him.
+				dy = clampf(src.y + dy, ry - LANE_REACH, ry + LANE_REACH) - src.y
 		var y := src.y + dy
 		var side := int(ev.get("side", 0))
