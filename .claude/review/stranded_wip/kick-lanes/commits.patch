From e2e30039765c0b14b6f97ef800028781bb01c557 Mon Sep 17 00:00:00 2001
From: gabebartolo-spec <gabebartolo@gmail.com>
Date: Tue, 10 Nov 2026 14:19:07 +1100
Subject: [PATCH] Kick lanes: the game plan picks corridor, switch or down the
 line, logged per kick and changing play (row T2.25)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/sim/MatchSim.gd           | 80 ++++++++++++++++++++++++++++++-
 scripts/ui/match/MatchDirector.gd | 27 +++++++++--
 tests/test_match_game.gd          | 72 ++++++++++++++++++++++++++++
 tools/visual/capture_match.gd     | 14 +++++-
 4 files changed, 185 insertions(+), 8 deletions(-)

diff --git a/scripts/sim/MatchSim.gd b/scripts/sim/MatchSim.gd
index 862c410e9..fe2d40ee6 100644
--- a/scripts/sim/MatchSim.gd
+++ b/scripts/sim/MatchSim.gd
@@ -463,6 +463,7 @@ func _init(home: Squad, away: Squad, seed: int = 0) -> void:
 	# Its own seed: it once shared lead_rng's, so the mid-kick intercept dice
 	# replayed the key-lead dice. Every stream here needs a seed of its own.
 	mid_ic_rng.seed = seed * 137 + 139
+	lane_rng.seed = seed * 163 + 167
 	injury_rng.seed = seed * 13 + 7
 	breeze_side = posmod(hash("breeze|%d" % seed), 2)
 	arch_rng.seed = seed * 151 + 157
@@ -943,6 +944,63 @@ const PLANS := {
 }
 
 
+## Kick lanes (row T2.25, ARD-M4-014; the director: "lanes are recorded and
+## affect play, not presentation only"). Every kick goes down one of three
+## lanes, weighted by the game plan: through the corridor, a switch across the
+## ground, or down the line. Each lane is a trade: the corridor gains the most
+## ground but is the easiest to read and pick off; down the line is safe from
+## the interceptor but runs out of bounds more; the switch gives up ground for
+## space, so the next touch is under less pressure. The lane is drawn from its
+## own stream (lane_rng), and each lane only scales a threshold, so the other
+## dice stay where they were. Weights and sizes are first values; the paired
+## lanes audit and any tuning wait in TODO section Z.
+const LANES := ["corridor", "switch", "line"]
+const LANE_PLAN := {
+	"balanced": {"corridor": 0.30, "switch": 0.15, "line": 0.55},
+	"attacking": {"corridor": 0.55, "switch": 0.10, "line": 0.35},
+	"defensive": {"corridor": 0.20, "switch": 0.15, "line": 0.65},
+	"contest": {"corridor": 0.25, "switch": 0.10, "line": 0.65},
+	"controlled": {"corridor": 0.25, "switch": 0.35, "line": 0.40},
+}
+## Per lane: gain (metres of the kick), turn (a rushed kick going to the
+## opposition), read (the mid-kick intercept through the middle), out (the
+## kick running over the boundary).
+const LANE_FX := {
+	"corridor": {"gain": 1.10, "turn": 1.20, "read": 1.40, "out": 0.50},
+	"switch": {"gain": 0.70, "turn": 1.00, "read": 1.00, "out": 1.00},
+	"line": {"gain": 1.00, "turn": 0.90, "read": 0.50, "out": 1.60},
+}
+## After a switch, the next touch's pressure (the ground opened up).
+const LANE_SWITCH_SPACE := 0.80
+var lane_rng := RandomNumberGenerator.new()
+## The weights this match draws from (a copy of LANE_PLAN; a test can force one lane).
+var lane_plan: Dictionary = LANE_PLAN.duplicate(true)
+## Kicks per lane, and "<lane>_m" the metres they gained, for each side; bookkeeping for the balance harness, no dice.
+var lane_log := [{}, {}]
+## The lane of the kick in flight, "" after a handball; the switch's space waits
+## for the next touch of the same chain.
+var _lane_now := ""
+var _switch_open := false
+
+
+## The lane of `side`'s next kick, drawn from lane_rng by its game plan.
+func _pick_lane(side: int) -> String:
+	var w: Dictionary = lane_plan.get(_plan(side), lane_plan["balanced"])
+	var r := lane_rng.randf()
+	var acc := 0.0
+	for lane in LANES:
+		acc += float(w[lane])
+		if r < acc:
+			return lane
+	return "line"
+
+
+func _lane_fx(key: String) -> float:
+	if _lane_now == "":
+		return 1.0
+	return float((LANE_FX[_lane_now] as Dictionary)[key])
+
+
 ## How much of a plan's upside the day allows (ARD-M4-016, the director:
 ## "contested footy is better in the wet as it's less precise; in dry weather
 ## ball handling is easier and it's easier to mark the ball"). A perfect day is
@@ -3085,6 +3143,8 @@ func _boundary_exit(side: int, cross_fp: float, carrier, disposal_kind: String,
 	if marked:
 		return {}
 	var chance := BOUNDARY_EXIT_P + (BOUNDARY_RUSHED_BONUS if rushed else 0.0)
+	if disposal_kind == "kick":
+		chance *= _lane_fx("out")
 	if boundary_rng.randf() >= chance:
 		return {}
 	var out_on_full := disposal_kind == "kick" and boundary_rng.randf() < OUT_ON_FULL_SHARE
@@ -3133,6 +3193,8 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 	_broke_press = -1
 	_exit_open = false
 	_post_exit = false
+	_lane_now = ""
+	_switch_open = false
 	var atk_fp := fp if side == 0 else -fp
 	var cleared = _stoppage(side, opp, from_bounce, atk_fp >= f50)
 	# A chain that starts inside its forward 50 (a ball-up won there) goes
@@ -3225,6 +3287,7 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 				+ 0.30 * (100.0 - _a(carrier, "marking")) / 100.0)
 		var disposal_kind := "handball"
 		var marked := false
+		_lane_now = ""
 		# A kick-in is kicked: no handball roll for its first disposal.
 		if not (from_kick_in and touches == 1) \
 				and rng.randf() < float(T["handball_share"]) * hb_bias \
@@ -3237,6 +3300,8 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 			disposal_kind = "kick"
 			last_kicker = carrier
 			last_kick_fp = fp
+			_lane_now = _pick_lane(side)
+			lane_log[side][_lane_now] = int((lane_log[side] as Dictionary).get(_lane_now, 0)) + 1
 			if counts_disposal:
 				_t(side, "kicks")
 				_p(carrier, "kicks")
@@ -3250,6 +3315,7 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 			else:
 				_emit("kick", side, fp, carrier, "%s kicks" % GameDB.player_display_name(carrier))
 			disposal_event = events.size() - 1
+			events[disposal_event]["lane"] = _lane_now
 			if is_kick_in:
 				var kev: Dictionary = events[events.size() - 1]
 				kev["kick_in"] = true
@@ -3289,6 +3355,10 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 		if _burst(side, "hold"):
 			_credit(side, "bursts", pressure * (1.0 - HOLD_TAKEN) * TURNOVER_VALUE)
 			pressure *= HOLD_TAKEN
+		if _switch_open:
+			# The switch found space: this touch is under less pressure.
+			pressure *= LANE_SWITCH_SPACE
+			_switch_open = false
 
 		# One roll, three outcomes: a tackle, a pressured (rushed) disposal,
 		# or no pressure at all. Both of the first two are pressure acts.
@@ -3363,6 +3433,7 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 				turn_p *= PRESS_ZONE_TURNOVER
 			if in_d50:
 				turn_p *= _tv("D50_TURNOVER", D50_TURNOVER)
+			turn_p *= _lane_fx("turn")
 			if rng.randf() < turn_p:
 				# Rushed into a pack: sometimes nobody gets it clean and the
 				# umpire calls a ball-up where it locked up.
@@ -3419,7 +3490,7 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 		if disposal_kind == "kick":
 			if in_d50:
 				gain *= _tv("D50_KICK_GAIN", D50_KICK_GAIN)
-			gain = minf(gain, kick_range(carrier))
+			gain = minf(gain * _lane_fx("gain"), kick_range(carrier))
 		if is_kick_in:
 			gain *= 0.82 if not kick_in_play_on else 1.12
 		if rushed:
@@ -3433,6 +3504,9 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 		atk_fp = fp if side == 0 else -fp
 		_last_disp["kind"] = disposal_kind
 		_metres(side, carrier, atk_fp - prev_atk_fp)
+		if _lane_now != "":
+			var lm := _lane_now + "_m"
+			lane_log[side][lm] = float((lane_log[side] as Dictionary).get(lm, 0.0)) + atk_fp - prev_atk_fp
 		_run_and_carry(side, carrier, atk_fp - prev_atk_fp, rushed or tackled, is_kick_in, disposal_event, prev_atk_fp)
 		# Rebound 50 (Champion Data): his kick or handball takes the ball from
 		# inside his defensive 50 out of it, however his side came by it (a
@@ -3445,6 +3519,8 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 		# the ball). The genuine contests - an aerial ball, a stoppage, a
 		# spill - set their own below and at the chain's start.
 		next_gain = "up"
+		# A clean switch opens the ground for whoever takes it.
+		_switch_open = _lane_now == "switch" and not rushed
 
 		# Outside forward 50, a genuine long kick can become a contested
 		# aerial ball. A mark retains it; a spoil makes the next chain loose.
@@ -3479,7 +3555,7 @@ func play_chain(side: int, fp: float, from_bounce: bool, from_kick_in := false)
 				continue
 			# Row 89: a kick through the middle with no contest can be read
 			# and taken outright by one of their midfielders.
-			if aerial.is_empty() and _aerial_zone(opp, fp) == "middle" 					and mid_ic_rng.randf() < _tv("MID_KICK_INTERCEPT", MID_KICK_INTERCEPT):
+			if aerial.is_empty() and _aerial_zone(opp, fp) == "middle" 					and mid_ic_rng.randf() < _tv("MID_KICK_INTERCEPT", MID_KICK_INTERCEPT) * _lane_fx("read"):
 				var taken := _mid_kick_intercept(side, fp)
 				if not taken.is_empty():
 					_last_disp["end"] = "aerial"
diff --git a/scripts/ui/match/MatchDirector.gd b/scripts/ui/match/MatchDirector.gd
index 741485955..5d47364d7 100644
--- a/scripts/ui/match/MatchDirector.gd
+++ b/scripts/ui/match/MatchDirector.gd
@@ -1049,17 +1049,34 @@ func _loc(k: int) -> Vector2:
 			dy = clampf(dy_raw * 0.7, -32.0, 32.0) + _rng.randf_range(-5.0, 5.0)
 			if absf(x - src.x) < 12.0 and absf(dy) < 10.0:
 				dy = (signf(dy_raw) if dy_raw != 0.0 else 1.0) * _rng.randf_range(10.0, 18.0)
-			# (The roll is made as before whatever the plan, so the stream is unchanged.)
-			if absf(src.y) > 22.0 and _rng.randf() < 0.1 and _plan_of(int(ev.get("side", 0))) != "attacking":
-				dy = -src.y * 1.3 + _rng.randf_range(-5.0, 5.0)   # a switch of play (never down the corridor)
+			# The kick's lane is MatchSim's (row T2.25: chosen by the game plan
+			# and logged on the kick). A replay from before lanes has none and
+			# keeps the old random switch. (The roll is made either way, so the
+			# stream is unchanged.)
+			var lane := str((events[pk] as Dictionary).get("lane", "")) if pk >= 0 else ""
+			var roll := _rng.randf()
+			var wing := signf(src.y) if absf(src.y) > 4.0 else (signf(ry) if ry != 0.0 else 1.0)
+			match lane:
+				"corridor":
+					dy = -src.y * 0.8 + _rng.randf_range(-6.0, 6.0)
+				"switch":
+					# Across to the far wing.
+					dy = -wing * _rng.randf_range(26.0, 36.0) - src.y
+				"line":
+					# Along his own boundary line (the clamp below keeps it in play).
+					dy = wing * _rng.randf_range(38.0, 46.0) - src.y
+				_:
+					if absf(src.y) > 22.0 and roll < 0.1 and _plan_of(int(ev.get("side", 0))) != "attacking":
+						dy = -src.y * 1.3 + _rng.randf_range(-5.0, 5.0)   # a switch of play
 		var y := src.y + dy
 		var side := int(ev.get("side", 0))
-		if _plan_of(side) == "attacking" and a >= 0 and int(tokens[a]["side"]) == side and _lane.has(a):
+		var kick_lane := str((events[pk] as Dictionary).get("lane", "")) if pk >= 0 and not hb else ""
+		if _plan_of(side) == "attacking" and kick_lane in ["", "corridor"] and a >= 0 				and int(tokens[a]["side"]) == side and _lane.has(a) and absf(float(_lane[a])) < 16.0:
 			# Attack Corridor: the ball goes to the receiver's lane. He leads
 			# from his slot, up his lane, never across to the ball, so the
 			# receivers never converge on one column.
 			y = float(_lane[a]) + _rng.randf_range(-1.0, 1.0)
-		elif x * _dir(side) < -45.0:
+		elif kick_lane == "" and x * _dir(side) < -45.0:
 			y *= 1.15   # clearing from defence: toward the boundary, away from the corridor
 		p = Vector2(x, y)
 		if hb and p.distance_to(src) < 3.0:
diff --git a/tests/test_match_game.gd b/tests/test_match_game.gd
index c98c7c3de..e67d98a1c 100644
--- a/tests/test_match_game.gd
+++ b/tests/test_match_game.gd
@@ -57,6 +57,7 @@ func run() -> void:
 	_t("_test_spoils_and_crumbs")
 	_t("_test_roaming_interceptor")
 	_t("_test_six_plans")
+	_t("_test_kick_lanes")
 	_t("_test_press_by_zone")
 	_t("_test_zone_intercepts")
 	_t("_test_rotation_words_true")
@@ -4080,6 +4081,77 @@ func _test_six_plans() -> void:
 			"Five plans (balanced and four others), and the old names read as the merged ones")
 
 
+## Kick lanes (row T2.25; the director: "lanes are recorded and affect play,
+## not presentation only"). Every kick logs its lane, the game plan decides how
+## often each lane is chosen, and the lane changes what the kick does.
+func _test_kick_lanes() -> void:
+	var seeds := [3101, 3102, 3103, 3104]
+	_check(seeds.size() == 4, "Four paired seeds")
+	# Recorded: every kick and kicked mark carries a lane; no handball does.
+	var sim := _sim(3101)
+	var r := sim.run()
+	var kicks := 0
+	var tagged := 0
+	var hb_clean := true
+	for e in r["events"]:
+		var kind := str(e.get("kind", ""))
+		if kind == "kick" or kind == "mark":
+			kicks += 1
+			if MatchSim.LANES.has(str(e.get("lane", ""))):
+				tagged += 1
+		elif kind == "handball":
+			hb_clean = hb_clean and not e.has("lane")
+	_check(kicks > 50 and tagged == kicks, "Every kick logs its lane (%d of %d)" % [tagged, kicks])
+	_check(hb_clean, "A handball has no lane")
+	# Chosen by the plan: the same seeds, side 0 on each plan.
+	var share := {}
+	for plan in ["balanced", "attacking", "defensive", "controlled"]:
+		var n := {"corridor": 0, "switch": 0, "line": 0}
+		for sd in seeds:
+			var s := _sim(sd)
+			s.set_tactics(0, {"gameplan": plan})
+			s.run()
+			for lane in MatchSim.LANES:
+				n[lane] += int((s.lane_log[0] as Dictionary).get(lane, 0))
+		var tot := float(n["corridor"] + n["switch"] + n["line"])
+		share[plan] = {"corridor": n["corridor"] / tot, "switch": n["switch"] / tot, "line": n["line"] / tot}
+	_check(share["attacking"]["corridor"] > share["balanced"]["corridor"] + 0.15
+			and share["attacking"]["corridor"] > share["defensive"]["corridor"] + 0.25,
+			"Attack Corridor kicks through the corridor most (%s)" % str(share))
+	_check(share["controlled"]["switch"] > share["balanced"]["switch"] + 0.12,
+			"Controlled Tempo switches the most (%s)" % str(share))
+	_check(share["defensive"]["line"] > share["attacking"]["line"] + 0.2,
+			"Defensive Press goes down the line most (%s)" % str(share))
+	# Affects play: both sides forced down one lane, paired seeds.
+	var out := {}
+	for lane in MatchSim.LANES:
+		var o := {"m_per_kick": 0.0, "throwins": 0, "score": 0}
+		var k := 0
+		for sd in seeds:
+			var s := _sim(sd)
+			var only := {"corridor": 0.0, "switch": 0.0, "line": 0.0}
+			only[lane] = 1.0
+			for plan in s.lane_plan:
+				s.lane_plan[plan] = only
+			var rr := s.run()
+			for side in range(2):
+				o["m_per_kick"] += float((s.lane_log[side] as Dictionary).get(lane + "_m", 0.0))
+				k += int((s.lane_log[side] as Dictionary).get(lane, 0))
+			for e in rr["events"]:
+				if str(e.get("kind", "")) == "throwin":
+					o["throwins"] += 1
+			o["score"] += int(rr["score"][0]) + int(rr["score"][1])
+		o["m_per_kick"] /= maxf(1.0, float(k))
+		out[lane] = o
+	_check(out["corridor"]["m_per_kick"] > out["line"]["m_per_kick"]
+			and out["line"]["m_per_kick"] > out["switch"]["m_per_kick"],
+			"The corridor gains the most ground a kick, the switch the least (%s)" % str(out))
+	_check(out["line"]["throwins"] > out["corridor"]["throwins"],
+			"Down the line runs out of bounds more than the corridor (%s)" % str(out))
+	_check(out["corridor"]["score"] != out["line"]["score"],
+			"The lane changes the scoreboard on the same seeds (%s)" % str(out))
+
+
 ## The full-time decision summary (director, 2026-10-11): each call has its
 ## own line, worth what it changed on average; a call not made is worth
 ## nothing; the lines and "the rest" add up to the margin.
diff --git a/tools/visual/capture_match.gd b/tools/visual/capture_match.gd
index 912c55ecb..95aaf51a1 100644
--- a/tools/visual/capture_match.gd
