diff --git a/scripts/ui/MediaConferenceScene.gd b/scripts/ui/MediaConferenceScene.gd
new file mode 100644
index 000000000..8a4093e64
--- /dev/null
+++ b/scripts/ui/MediaConferenceScene.gd
@@ -0,0 +1,158 @@
+extends Control
+## The post-match press conference as its own full screen (director, 2026-10-19:
+## "why is press conference still not a full screen scene?"). The press room
+## picture, the journalist and outlet, the question, the answers each with both
+## ways it can land and the odds, then how it landed. Done, Skip and Back all
+## return to where the coach came from (the hub). The rules and odds are
+## GameState's; nothing here changes them.
+
+var _name_index := {}
+var _root: VBoxContainer
+var _stage: Control = null
+var _scene: MediaConferenceVignette = null
+var _column: VBoxContainer         # question and answers, then the result
+var _revealed := false
+var _wide := false
+
+
+func _ready() -> void:
+	set_anchors_preset(Control.PRESET_FULL_RECT)
+	if GameState.season == null:
+		Router.replace("main")
+		return
+	# Nothing to answer (a stale route): straight back.
+	if not GameState.media_conference_pending():
+		Router.back.call_deferred()
+		return
+	add_child(ClubBackdrop.new().setup(GameState.my_club).live())
+	var margin := MarginContainer.new()
+	margin.set_anchors_preset(Control.PRESET_FULL_RECT)
+	UiKit.apply_insets(margin, 12)
+	add_child(margin)
+	_root = UiKit.vbox(10)
+	margin.add_child(_root)
+	_build()
+
+
+## Back is the Skip button: saying nothing is an answer the game remembers.
+func handle_back() -> bool:
+	_skip()
+	return false
+
+
+func _skip() -> bool:
+	if GameState.media_conference_pending():
+		GameState.skip_media_conference()
+	return false
+
+
+func _names() -> Dictionary:
+	if _name_index.is_empty() and GameState.season != null:
+		_name_index = NameInk.from_lists(GameState.season.lists)
+	return _name_index
+
+
+func _build() -> void:
+	UiKit.clear(_root)
+	var vw := UiKit.view_width(self)
+	var vh := UiKit.view_height(self)
+	_wide = ScreenLayout.roomy(vw, vh)
+	_root.add_child(UiKit.top_bar("Press conference", true, null, _skip))
+	_stage = null
+	_scene = null
+	var holder: BoxContainer = UiKit.hbox(28) if _wide else UiKit.vbox(10)
+	holder.name = "PressLayout"
+	holder.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	_root.add_child(holder)
+	if GameState.vignettes_on():
+		_stage = Control.new()
+		_stage.name = "MediaConferenceStage"
+		_stage.clip_contents = true
+		if _wide:
+			var w := minf(vw * 0.55, (vh - 90.0) * 1.6)
+			_stage.custom_minimum_size = Vector2(w, w / 1.6)
+			_stage.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+		else:
+			_stage.custom_minimum_size = Vector2(0, minf(280.0, vh * 0.34))
+		holder.add_child(_stage)
+		_scene = MediaConferenceVignette.open(_stage, GameState.my_club)
+	_column = UiKit.vbox(16 if _wide else 12)
+	_column.name = "MediaAnswers"
+	_column.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	if _wide:
+		_column.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+		holder.add_child(_column)
+	else:
+		holder.add_child(UiKit.scroll(_column))
+	_show_question()
+	if _scene != null and not _revealed:
+		_column.visible = false
+		_scene.ready_for_question.connect(func():
+			_revealed = true
+			if is_instance_valid(_column):
+				_column.visible = true)
+
+
+func _show_question() -> void:
+	UiKit.clear(_column)
+	var by := UiKit.lbl(str(GameState.media_conference.get("by", "Journalist")),
+			UiKit.H2 if _wide else UiKit.BODY, UiKit.MUTED, true)
+	by.name = "MediaByline"
+	_column.add_child(by)
+	var q := NameInk.label(str(GameState.media_conference.get("question", "")), _names(),
+			UiKit.H1 if _wide else 18, UiKit.TEXT, true)
+	q.name = "MediaQuestion"
+	q.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	_column.add_child(q)
+	var opts: Array = GameState.media_conference.get("options", [])
+	for i in range(opts.size()):
+		var group := UiKit.vbox(4)
+		group.name = "MediaAnswerGroup_%d" % i
+		_column.add_child(group)
+		var b := UiKit.btn(str((opts[i] as Dictionary).get("label", "")), UiKit.H2 if _wide else 16)
+		b.name = "MediaAnswer_%d" % i
+		b.custom_minimum_size = Vector2(0, 56)
+		b.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		NameInk.dress_button(b, _names())
+		var choice := i
+		b.pressed.connect(func(): _answer(choice))
+		group.add_child(b)
+		# Both ways it can land, with odds and sizes (bible s.4), in the page's
+		# own ink: the coach is deciding on it.
+		var effect := NameInk.label(MediaConference.odds_line(MediaConference.kind_of(opts[i], i),
+				GameState.press_chance(i)), _names(), UiKit.BODY if _wide else UiKit.SMALL, UiKit.TEXT)
+		effect.name = "MediaAnswerLine_%d" % i
+		effect.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+		group.add_child(effect)
+	var skip := UiKit.btn("Skip press conference", 14)
+	skip.name = "MediaSkip"
+	skip.flat = not _wide
+	skip.custom_minimum_size = Vector2(240 if _wide else 0, 44)
+	skip.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN if _wide else Control.SIZE_EXPAND_FILL
+	skip.pressed.connect(func():
+		_skip()
+		Router.back())
+	_column.add_child(skip)
+
+
+func _answer(choice: int) -> void:
+	var landed := GameState.resolve_media_conference(choice)
+	_show_result(landed)
+
+
+## How the answer landed (the bible: "the effect is visible afterwards").
+func _show_result(landed: Dictionary) -> void:
+	UiKit.clear(_column)
+	_column.visible = true
+	_column.add_child(UiKit.heading("After the press conference", UiKit.TITLE if _wide else UiKit.H1))
+	var l := UiKit.lbl(str(landed.get("line", "")), UiKit.H2 if _wide else 17, UiKit.TEXT)
+	l.name = "MediaOutcomeLine"
+	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	_column.add_child(l)
+	var ok := UiKit.btn("Done", UiKit.NAME, true)
+	ok.name = "MediaOutcomeDone"
+	ok.custom_minimum_size = Vector2(240 if _wide else 0, 52)
+	ok.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN if _wide else Control.SIZE_EXPAND_FILL
+	ok.pressed.connect(func(): Router.back())
+	_column.add_child(ok)
