diff --git a/tools/visual/capture_press_scene.gd b/tools/visual/capture_press_scene.gd
new file mode 100644
index 000000000..24adc8b56
--- /dev/null
+++ b/tools/visual/capture_press_scene.gd
@@ -0,0 +1,72 @@
+extends SceneTree
+## Visual review tool for the press conference as its own screen:
+##   godot --path . --script tools/visual/capture_press_scene.gd -- --out /tmp/pscene --club MEL
+## Writes <out>_phone_{question,result}.png (390x844) and <out>_pc_{question,result}.png (1280x720 logical),
+## each reached through the real route (hub -> Router "press").
+
+func _initialize() -> void:
+	_run.call_deferred()
+
+
+func _shot(n := 8) -> Image:
+	for i in range(n):
+		await process_frame
+	var img := root.get_viewport().get_texture().get_image()
+	img.convert(Image.FORMAT_RGBA8)
+	return img
+
+
+func _run() -> void:
+	var out := "/tmp/pscene"
+	var club := "MEL"
+	var a := OS.get_cmdline_user_args()
+	for i in range(a.size() - 1):
+		if str(a[i]) == "--out":
+			out = str(a[i + 1])
+		if str(a[i]) == "--club":
+			club = str(a[i + 1])
+	await process_frame
+	var state = root.get_node("GameState")
+	var db = root.get_node("GameDB")
+	var router = root.get_node("Router")
+	var MC = load("res://scripts/sim/MediaConference.gd")
+	state.autosave_enabled = false
+	state.save_path = "user://capture.save"
+	state.settings_path = "user://capture_settings.cfg"
+	state.reset()
+	state.set_setting("seen_weekly_loop_intro", true)
+	state.start_season(club, db.club_list(club))
+	for mode in [["phone", Vector2i(390, 844)], ["pc", Vector2i(1600, 900)]]:
+		# mode[1] is the LOGICAL canvas; the window is that times the OS scaling (as the
+		# director's 4K at 300% shows 1280x720).
+		var logical: Vector2i = Vector2i(1280, 720) if mode[0] == "pc" else mode[1]
+		var dens := maxf(1.0, float(DisplayServer.screen_get_dpi()) / 96.0) if mode[0] == "pc" else 1.0
+		var px := Vector2i(roundi(logical.x * dens), roundi(logical.y * dens))
+		root.size = px
+		DisplayServer.window_set_size(px)
+		for i in range(6):
+			await process_frame
+		var got: Vector2i = root.content_scale_size
+		if mode[0] == "pc" and got != logical and got.x > 0:
+			var k: float = float(px.x) / float(got.x)
+			px = Vector2i(roundi(logical.x * k), roundi(logical.y * k))
+			root.size = px
+			DisplayServer.window_set_size(px)
+			for i in range(6):
+				await process_frame
+		state.media_conference = MC.pick({"club": club, "opponent_name": "Carlton", "round": 8,
+				"result": {"home": club, "away": "CAR", "score": [55, 101]}}, {})
+		router.stack.clear()
+		router.go("hub")
+		for i in range(30):
+			await process_frame
+		var room = current_scene.find_child("MediaConferenceVignette", true, false)
+		if room != null:
+			room.call("finish_now")
+		(await _shot()).save_png("%s_%s_question.png" % [out, mode[0]])
+		var b = current_scene.find_child("MediaAnswer_0", true, false)
+		if b != null:
+			b.emit_signal("pressed")
+		(await _shot()).save_png("%s_%s_result.png" % [out, mode[0]])
+		router.stack.clear()
+	quit(0)
-- 
