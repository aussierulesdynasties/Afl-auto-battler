P=s['palette']
P.update(ground_default=[128,136,92],lawn=[104,136,66],yard=[118,138,84],sand=[196,184,156],water=[64,88,92],
 road=[80,80,80],path=[190,186,176],paved=[150,148,140],fairway=[62,96,46],parking=[98,98,96],
