# 2026 athletics-centre buildings (newer than the aerial), placed against track_poly from drone photos
# refs_mars/r22 (2026, looking N over the track) and r16 (looking S from the stadium):
# grandstand: white roof with a solar strip, along the SW straight, ~8 m gap, ~75 x 22 m;
# service building: grey roof, white walls, north half of the NE straight, ~55 x 18 m. Marquee = temporary, left out.
import math as _m
_u=(0.613,-0.790); _n=(-0.790,-0.613)
def _rect(c,L,W):
    return [[round(c[0]+sx*_u[0]*L/2+sy*_n[0]*W/2,2),round(c[1]+sx*_u[1]*L/2+sy*_n[1]*W/2,2)] for sx,sy in ((-1,-1),(1,-1),(1,1),(-1,1))]
_gs=(5.5+_n[0]*19,-245.2+_n[1]*19)
_sv=(79.5-_n[0]*17-_u[0]*15,-189.7-_n[1]*17-_u[1]*15)
s['extra_buildings']=[dict(p=_rect(_gs,75,22),h=9.0,roof=0,wall=0),dict(p=_rect(_sv,55,18),h=7.0,roof=2,wall=0)]
json.dump(s,open("spec/mars.json","w"),indent=1)
