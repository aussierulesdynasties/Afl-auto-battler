P=s['palette']
P.update(ground_default=[128,136,92],lawn=[104,136,66],yard=[118,138,84],sand=[196,184,156],water=[64,88,92],
 road=[80,80,80],path=[190,186,176],paved=[150,148,140],fairway=[62,96,46],parking=[98,98,96],
 walls_house=[[176,96,72],[226,222,212],[196,170,136],[150,84,64]],
 walls_block=[[232,230,222],[204,198,184],[176,104,80],[214,206,190]],
 walls_tower=[[226,228,226],[150,176,190],[96,124,140],[206,200,188]],
 roofs_house=[[176,96,66],[108,112,112],[196,198,192],[146,80,58],[78,84,90]],
 roofs_flat=[[214,216,212],[176,178,176],[150,152,150],[78,82,86],[140,78,56]],
 far_flat=[132,140,96],far_veg=[66,92,58],far_steep=[60,84,56],haze=[190,204,216],sky_top=[64,124,192],sky_hor=[196,212,226])
s['cover']=m['cover']+[['natural','wetland','reeds'],['landuse','island_fill','reeds'],['leisure','golf_course','fairway']]
s['tree_kinds']=['red_gum','ghost_gum','paperbark']
s['levels_default'].update({'*':5,'house':4.5,'residential':4.5,'detached':4.5,'apartments':10,'commercial':7,'office':10,'retail':7,'industrial':8,'warehouse':9,'school':7,'stadium':20})
json.dump(s,open('spec/mars.json','w'),indent=1)
