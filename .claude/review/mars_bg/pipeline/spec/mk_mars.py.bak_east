# 2026-11-21 fixes vs the aligned aerial (ortho overlay, 8 failed regions)
s['msbf_shift']=[-6,35]          # MS footprints sit on the same imagery as sat_raw: same correction as sat.png (measured: sheds/hall land on their roofs)
s['fence_clear']=True            # skip buildings under the ground model's outline (+3 m), not a 130 m circle (lost the south buildings)
s['split_big_roofs']=True        # >4000 m2 blocks split in ~25 m strips, each strip its own aerial roof colour (industrial halls)
s['cycle_asphalt']=True; P['cycleway']=[150,136,126]   # 2026 shared paths: grey measured on the aerial along way 1209
