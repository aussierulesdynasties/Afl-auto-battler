 ['quarry',[[441.4,306.4],[666.0,277.0],[652.7,25.7],[620.6,-1.1],[457.5,31.0],[428.1,15.0],[374.6,-81.3],[321.1,-188.2],[305.1,-215.0],[294.4,-134.8],[283.7,-17.1],[257.0,31.0],[326.5,57.7],[347.9,223.5],[401.3,266.3]]],
