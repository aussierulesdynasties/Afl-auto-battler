P['athletics']=[52,98,160]
s['track_poly']=[[54.2, -155.9], [50.3, -151.3], [45.8, -147.3], [40.8, -143.9], [35.4, -141.1], [29.7, -139.1], [23.8, -137.9], [17.7, -137.4], [11.7, -137.7], [5.7, -138.9], [-0.0, -140.7], [-5.5, -143.4], [-10.5, -146.7], [-15.1, -150.6], [-19.2, -155.1], [-22.6, -160.1], [-25.3, -165.5], [-27.3, -171.2], [-28.6, -177.1], [-29.1, -183.1], [-28.7, -189.2], [-27.6, -195.1], [-25.7, -200.9], [-23.1, -206.3], [-19.8, -211.4], [30.8, -278.9], [34.7, -283.5], [39.2, -287.6], [44.2, -291.0], [49.6, -293.7], [55.3, -295.8], [61.2, -297.0], [67.3, -297.5], [73.3, -297.1], [79.3, -296.0], [85.0, -294.2], [90.5, -291.5], [95.5, -288.2], [100.1, -284.3], [104.2, -279.8], [107.6, -274.8], [110.3, -269.4], [112.4, -263.7], [113.6, -257.8], [114.1, -251.7], [113.7, -245.7], [112.6, -239.8], [110.7, -234.0], [108.1, -228.5], [104.8, -223.5]]
