# Godot 4
.godot/
*.translation
export.cfg
export_credentials.cfg

# Exported builds
build/
builds/
export/
*.apk
*.aab
*.ipa

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Python harness caches
__pycache__/
*.pyc

# Generated by tools/sim_harness.py --ratings
data/ratings_preview.csv

# Scraper page cache (tools/build_history.py, tools/scrape_afltables.py)
data/cache/

# Stray large files that sit in the working copy and are never source:
# a 67 MB model at the repo root, and the director's review captures.
/*.glb
docs/research/_review_*/

# Written by the Web build workflow (short commit shown as the build label)
build_info.txt

# Test dumps for a person to read (coach_arcs story log)
tests/output/
.balance/

# Godot never imports captures/ or docs/ (each has a .gdignore); no sidecars there.
captures/**/*.import
docs/**/*.import
tools/wheelo/cache/
/ground_packs.json

# textures Godot extracts from the background scenes on import (row 202 2b)
assets/grounds/*/*_backdrop_part*_*.webp
assets/grounds/*/*_backdrop_part*_*.webp.import
assets/grounds/*/*_backdrop_part*_*.png
assets/grounds/*/*_backdrop_part*_*.png.import
assets/grounds/*/*_backdrop_part*_*.jpg
assets/grounds/*/*_backdrop_part*_*.jpg.import
# Review boards, WIP films, reference photos and aerial imagery live in the private repo
# aussierulesdynasties/afl-review-archive (same paths), never here: this repo is public (2026-11-26).
# Tools still write boards into .claude/review/ on your machine; commit them to the archive.
.claude/review/

# Blender autosave backups, editor/script backups and tool run logs: never source.
*.blend[0-9]
*.blend[0-9][0-9]
*.bak
*.log
# Director review dumps (rating rebuild, 2026-11-25): read in place, never committed.
/REVIEW.md
# Numbered backups (scene.py.bak36, clad_rib.png.bak31): *.bak above misses them.
*.bak[0-9]*
# Blender scenes are working files, archived on the PC (docs/3D_INVENTORY.md); the game loads the .glb.
# The two already tracked under .claude/review stay tracked until someone moves them.
*.blend
