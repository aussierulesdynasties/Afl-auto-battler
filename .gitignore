# Godot 4
.godot/
*.translation
export.cfg
export_credentials.cfg

# Exported builds
build/
builds/
export/
*.apk
*.aab
*.ipa

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Python harness caches
__pycache__/
*.pyc

# Generated by tools/sim_harness.py --ratings
data/ratings_preview.csv

# Scraper page cache (tools/build_history.py, tools/scrape_afltables.py)
data/cache/

# Stray large files that sit in the working copy and are never source:
# a 67 MB model at the repo root, and the director's review captures.
/*.glb
docs/research/_review_*/

# Written by the Web build workflow (short commit shown as the build label)
build_info.txt

# Test dumps for a person to read (coach_arcs story log)
tests/output/
.balance/

# Godot never imports captures/ or docs/ (each has a .gdignore); no sidecars there.
captures/**/*.import
docs/**/*.import
tools/wheelo/cache/

# Epic/MetaHuman files: kept in a private repo, copied in by tools/epic_assets.sh fetch
