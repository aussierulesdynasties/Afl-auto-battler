; Engine configuration file.
; Godot 4.7 — Aussie Rules Dynasties
;
; Targets desktop (Windows/macOS/Linux) and mobile (Android/iOS).
; See docs/DESIGN.md for architecture notes.

config_version=5

[application]

config/name="Aussie Rules Dynasties"
config/description="Build an Australian rules football dynasty: shape your list, coach the season and carry the club through the years."
config/version="1.0.7"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"
; Android's back button goes through Router.handle_back() instead of quitting.
config/quit_on_go_back=false
; Battery: redraw only when something on screen changes (an idle hub or
; menu drew every frame - measured 35/s under software rendering, 0.2/s
; with this) and never above 60 fps on high-refresh phones. The match view
; and vignettes ask for their own frames while they animate.
run/low_processor_mode=true
run/max_fps=60

[autoload]

ScreenLayout="*res://scripts/core/ScreenLayout.gd"

GameDB="*res://scripts/core/GameDB.gd"
GameState="*res://scripts/state/GameState.gd"
MusicManager="*res://scripts/core/MusicManager.gd"
ScreenTransition="*res://scripts/core/ScreenTransition.gd"
Router="*res://scripts/core/Router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; SCREEN_PORTRAIT: a phone plays in portrait only (director, 2026-11-05: "Drop landscape").
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
; Smooth edges across the game (director, 2026-10-06): 2D MSAA 2x, plus
; per-draw antialiasing on the lines the views draw themselves.
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_2d.web=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.071, 0.067, 0.063, 1)

[features]

; Feature switches (scripts/core/Features.gd). Every switch ships ON (director
; 2026-11-06: "i ALWAYS want them on"). Tests that need the old path force it
; with Features.set_on(name, false).
preseason=true
speccy_front=true
training_report=true
international_prospects=true
expansion_package=true
club_almanac=true
match_story=true
finals_cards_2=true
player_looks=true
coach_arcs=true
top_attributes=true
kick_range=true
match_flow=true
ballup_two=true
goal_run_moves=true
clanger_cause=true
decision_scenes=true
ui_motion=true
feed_colours=true
training_grid=true
midseason_draft=true
vignette_grade=true
custom_prospect_story=true
rookie_list=true
mid_intercepts=true
back_carries=true
momentum_runaway=true
key_duels=true
set_shots=true
sir_doug_round=true
gather_round=true
league_news=true
gen_traits=true

